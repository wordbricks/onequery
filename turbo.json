{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "signature": true
  },
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "npm_config_user_agent",
    "npm_execpath",
    "PATH",
    "GITHUB_ACTIONS_INTEGRATION_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["ONEQUERY_E2E"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.DS_Store", "!**/target/**"],
      "outputs": ["dist/**", "dist-worker/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "LOCAL_AGENT",
        "CONNECTOR_ABORT_ON_AUTH_FAILURE",
        "CONNECTOR_ABORT_ON_PREREQ_FAILURE",
        "DATABASE_URL",
        "ONEQUERY_LANDING_DEV_PORT",
        "ONEQUERY_RUNTIME_ROOT"
      ]
    },
    "dev:container": {
      "cache": false,
      "persistent": true
    },
    "//#check": {
      "dependsOn": ["//#lint", "//#format"]
    },
    "//#check:fix": {
      "dependsOn": ["//#lint:fix", "//#format:fix"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "dependsOn": ["//#lint:fix"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.DS_Store", "!**/target/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.DS_Store", "!**/target/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.DS_Store", "!**/target/**"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "topo": {
      "dependsOn": ["^topo"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.DS_Store", "!**/target/**"]
    },
    "typecheck": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.DS_Store", "!**/target/**"]
    },
    "//#typecheck:root": {}
  }
}
