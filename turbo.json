{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["ONEQUERY_E2E"],
      "outputs": ["dist/**", "dist-worker/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["LOCAL_AGENT"]
    },
    "dev:container": {
      "cache": false,
      "persistent": true
    },
    "//#check": {
      "dependsOn": ["//#lint", "//#format"]
    },
    "//#check:fix": {
      "dependsOn": ["//#lint:fix", "//#format:fix"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "dependsOn": ["//#lint:fix"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "topo": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["topo"]
    },
    "//#typecheck:root": {}
  }
}
