{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "bun": true,
  "github-actions": true,
  "oxlint": {
    "config": [".oxlintrc.jsonc"],
  },
  "treatConfigHintsAsErrors": true,
  // Examples are standalone demo projects, not part of the monorepo package surface.
  "ignore": ["examples/**"],
  "ignoreDependencies": [
    "eslint-plugin-turbo",
    // Buf resolves this local plugin name from proto/buf.gen.yaml.
    "@bufbuild/protoc-gen-es",
  ],
  // `apps/cli/package.json` intentionally shells out to the system `just` binary.
  // The full Knip run reports it as unlisted without this ignore.
  "ignoreBinaries": ["just"],
  "ignoreIssues": {
    "apps/dashboard/src/server/auth-rate-limit.ts": ["unlisted"],
    ".github/workflows/cli-release.yml": ["binaries"],
    "apps/landing/src/app/routeTree.gen.ts": ["types"],
    "packages/cli-server/generated/**/*.ts": ["exports", "types"],
  },
  "workspaces": {
    ".": {
      "entry": [
        "turbo.json",
        "scripts/upload-image.ts",
        "scripts/oxlint/plugin.mjs",
      ],
      "project": ["*.json", "scripts/**/*.ts", "scripts/**/*.mjs"],
    },
    "apps/*": {
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.{ts,tsx}"],
    },
    "apps/cli": {
      "bun": false,
      "entry": [
        "bin/*.js",
        "scripts/build-server-bundle.js",
        "scripts/stage-npm-packages.js",
      ],
      "project": ["bin/*.js", "scripts/*.js"],
    },
    "apps/dashboard": {
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.{ts,tsx}",
        "!src/vite-env.d.ts",
      ],
      "ignoreDependencies": [
        "tailwindcss",
        // Loaded via a variable dynamic import in vite.config.ts for dev-only config.
        "@onequery/config-node",
      ],
    },
    "apps/landing-video": {
      "entry": ["remotion.config.ts"],
      "ignoreDependencies": [
        // Used from src/index.css via `@import "tailwindcss"`.
        "tailwindcss",
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
    },
    "packages/*": {
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
    },
    "packages/cli-server": {
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
    },
    "packages/server": {
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.{ts,tsx}"],
    },
    "packages/db": {
      "entry": ["src/scripts/seed-dev.ts"],
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
    },
  },
}
