    "@tabler/icons-react": "catalog:",
    "@tanstack/react-query": "5.90.20",
    "@tanstack/react-query-persist-client": "5.90.20",
    "@tanstack/react-router": "1.153.1",
    "@tanstack/zod-adapter": "1.153.1",
    "@xstate/react": "6.0.0",
