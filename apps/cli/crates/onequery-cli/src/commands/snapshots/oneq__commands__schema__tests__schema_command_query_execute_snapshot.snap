    "query_execution_timed_out",
    "invalid_request"
  ],
  "http": {
    "method": "POST",
    "operationId": "cliQueryExecute",
    "path": "/organizations/{orgSlug}/sources/{sourceKey}/queries:execute"
  },
  "inputSchema": {
