            }
          },
          "type": "object"
        },
        "type": "array"
      },
      "elapsedMs": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "rowCount": {
        "maximum": 9007199254740991,
        "minimum": 0,
