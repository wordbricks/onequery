set positional-arguments

# Display help
help:
    just -l

# `onequery`
alias o := onequery
onequery *args:
    cargo run --bin onequery -- "$@"

# format code
fmt:
    cargo fmt -- --config imports_granularity=Item 2>/dev/null

typecheck *args:
    cargo check --tests "$@"

lint *args:
    cargo clippy --tests "$@"

fix *args:
    cargo clippy --fix --tests --allow-dirty "$@"

clippy *args:
    cargo clippy --tests "$@"

install:
    rustup show active-toolchain
    cargo fetch

build *args:
    cargo build "$@"

# Run `cargo nextest` since it's faster than `cargo test`, though including
# --no-fail-fast is important to ensure all tests are run.
#
# Run `cargo install cargo-nextest` if you don't have it installed.
test *args:
    # CONTEXT: Turbo/CI should use the same `just test` entrypoint as local
    # development, but not every environment has cargo-nextest installed.
    if command -v cargo-nextest >/dev/null 2>&1; then cargo nextest run --no-fail-fast "$@"; else cargo test "$@"; fi

test-cargo *args:
    cargo test "$@"

check:
    cargo fmt -- --check --config imports_granularity=Item 2>/dev/null
    just lint
    just check-proto

# Regenerate CLI transport adapters from the protobuf source of truth.
regen-proto:
    bun run --cwd {{justfile_directory()}}/../.. proto:generate
    just regen-rust-proto

check-proto:
    bun run --cwd {{justfile_directory()}}/../.. proto:check
    just regen-rust-proto
    git diff --exit-code -- crates/proto-cli/src/generated crates/proto-runtime/src/generated

regen-rust-proto:
    mise exec cargo:connectrpc-codegen@0.6.0 cargo:protoc-gen-buffa@0.6.0 cargo:protoc-gen-buffa-packaging@0.6.0 -- bun run --cwd {{justfile_directory()}}/../.. proto:generate:rust

insta-pending *args:
    cargo insta pending-snapshots "$@"

insta-show *args:
    cargo insta show "$@"

insta-accept *args:
    cargo insta accept "$@"
