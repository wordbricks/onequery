{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "AR",
        "CC",
        "CXX",
        "DEVELOPER_DIR",
        "MACOSX_DEPLOYMENT_TARGET",
        "SDKROOT"
      ]
    },
    "topo": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "justfile",
        ".cargo/**",
        "crates/**/Cargo.toml",
        "crates/**/build.rs",
        "crates/**/*.rs",
        "$TURBO_ROOT$/packages/cli-contract/openapi/generated/cli.openapi.json"
      ]
    },
    "typecheck": {
      "env": [
        "AR",
        "CC",
        "CXX",
        "DEVELOPER_DIR",
        "MACOSX_DEPLOYMENT_TARGET",
        "SDKROOT"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "justfile",
        ".cargo/**",
        "crates/**/Cargo.toml",
        "crates/**/build.rs",
        "crates/**/*.rs",
        "$TURBO_ROOT$/packages/cli-contract/openapi/generated/cli.openapi.json"
      ]
    },
    "test": {
      "env": [
        "AR",
        "CC",
        "CXX",
        "DEVELOPER_DIR",
        "MACOSX_DEPLOYMENT_TARGET",
        "SDKROOT"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "justfile",
        ".config/nextest.toml",
        ".cargo/**",
        "crates/**/Cargo.toml",
        "crates/**/build.rs",
        "crates/**/*.rs",
        "crates/**/*.snap",
        "$TURBO_ROOT$/packages/cli-contract/openapi/generated/cli.openapi.json"
      ]
    }
  }
}
