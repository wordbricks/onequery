{
  "name": "@onequery/cli",
  "version": "0.0.0-dev",
  "private": false,
  "description": "OneQuery CLI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wordbricks/onequery.git",
    "directory": "apps/cli"
  },
  "bin": {
    "onequery": "bin/onequery.js"
  },
  "files": [
    "bin",
    "runtime",
    "vendor",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:cli": "just onequery",
    "build": "just build",
    "typecheck": "sh -c 'if command -v just >/dev/null 2>&1; then just typecheck; else cargo check --tests; fi'",
    "test": "sh -c 'if command -v just >/dev/null 2>&1; then just test; else if command -v cargo-nextest >/dev/null 2>&1; then cargo nextest run --no-fail-fast; else cargo test; fi; fi'",
    "test:integration": "vitest run scripts/self-host-smoke.integration.test.ts",
    "release:homebrew:formula": "node scripts/generate-homebrew-formula.js",
    "fix": "just fix"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-node": "catalog:",
    "@onequery/base": "workspace:*",
    "rolldown": "1.0.0-rc.15",
    "vitest": "catalog:testing"
  }
}
