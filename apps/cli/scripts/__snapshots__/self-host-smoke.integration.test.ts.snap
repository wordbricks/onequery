      "cellMaxChars": 256,
      "maxBytes": 4096,
      "maxRows": 100,
      "timeoutMs": 1000,
    },
    "normalizedSql": "SELECT 1 LIMIT 1000",
    "request": {
      "cellMaxChars": 256,
      "maxBytes": 4096,
      "maxRows": 100,
      "sql": "SELECT 1 LIMIT 1000",
      "timeoutMs": 1000,
    },
    "source": {
      "provider": "POSTGRES",
      "queryable": true,
      "sourceKey": "Warehouse",
      "status": "ACTIVE",
    },
    "sqlNormalized": true,
  },
}
`;

