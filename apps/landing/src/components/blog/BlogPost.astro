---
import type { BlogPost, BlogPostSection } from "../../landing/blog/blog-posts";
import { blogPostSummaries } from "../../landing/blog/blog-posts";
import SiteFooter from "../landing/SiteFooter.astro";
import SiteHeader from "../landing/SiteHeader.astro";
import {
  BLOG_POST_IMAGE_SIZES,
  BLOG_POST_IMAGE_WIDTHS,
} from "./blog-image-presets";
import BlogPostParagraph from "./BlogPostParagraph.astro";
import LinkedText from "./LinkedText.astro";
import OptimizedBlogImage from "./OptimizedBlogImage.astro";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

function getPostSections(input: BlogPost): BlogPostSection[] {
  if (input.sections) {
    return input.sections;
  }

  return [
    {
      id: "why-it-matters",
      paragraphs: [input.body[0] ?? ""],
      title: "Why it matters",
    },
    {
      id: "how-it-works",
      paragraphs: [input.body[1] ?? ""],
      title: "How it works",
    },
    {
      id: "what-comes-next",
      paragraphs: [
        "The next step is making these workflows easier to inspect while they are running. Teams should be able to see the current state, the pending decision, and the artifact that will be reviewed before anything changes.",
      ],
      title: "What comes next",
    },
  ];
}

function getFigureClass(section: BlogPostSection) {
  return section.imagePlacement === "after-title"
    ? "blog-post-figure blog-post-figure-after-title"
    : "blog-post-figure";
}

const sections = getPostSections(post);
const relatedPosts = blogPostSummaries
  .filter(
    (relatedPost) =>
      relatedPost.slug !== post.slug && relatedPost.category === post.category
  )
  .slice(0, 3);
const fallbackRelatedPosts = blogPostSummaries
  .filter((relatedPost) => relatedPost.slug !== post.slug)
  .slice(0, 3);
const visibleRelatedPosts =
  relatedPosts.length > 0 ? relatedPosts : fallbackRelatedPosts;

const blogNavigationItems = [
  { href: "/", label: "Product" },
  { href: "/blog", label: "Blog" },
] as const;
const blogFooterLinks = [{ href: "https://github.com/wordbricks/onequery", label: "GitHub" }];
---

<div class="page-shell blog-shell">
  <SiteHeader navigationItems={blogNavigationItems} />

  <main class="blog-post-main">
    <article id="top">
      <header class="blog-post-header">
        <div class="blog-breadcrumb">
          <a href="/blog">Blog</a>
          <span aria-hidden="true">/</span>
          <span>{post.category}</span>
        </div>
        <p class="blog-post-date">
          {post.date} <span aria-hidden="true">-</span> {post.category}
        </p>
        <h1>{post.title}</h1>
      </header>

      <div class="blog-post-byline">
        <span>OneQuery Maintainers</span>
        <span aria-hidden="true">-</span>
        <span>{post.readTime}</span>
      </div>

      <div class="blog-post-layout">
        <aside class="blog-post-toc">
          <h2>Table of Contents</h2>
          <nav>
            <a href="#top">Up</a>
            {sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
          </nav>
        </aside>

        <div class="blog-post-body">
          <p class="blog-post-deck">{post.description}</p>
          {
            sections.map((section) => (
              <section id={section.id}>
                <h2>{section.title}</h2>
                {section.imagePlacement === "after-title" && section.imageSrc ? (
                  <figure class={getFigureClass(section)}>
                    <OptimizedBlogImage
                      src={section.imageSrc}
                      alt={section.imageAlt ?? ""}
                      sizes={BLOG_POST_IMAGE_SIZES}
                      widths={BLOG_POST_IMAGE_WIDTHS}
                    />
                  </figure>
                ) : null}
                {section.paragraphs.map((paragraph, paragraphIndex) => (
                  <BlogPostParagraph
                    section={section}
                    paragraph={paragraph}
                    paragraphIndex={paragraphIndex}
                  />
                ))}
                {section.table ? (
                  <div class="blog-post-table-wrap">
                    <table class="blog-post-table">
                      <thead>
                        <tr>
                          {section.table.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {section.table.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td><LinkedText text={cell} /></td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ) : null}
                {section.images?.map((image) => (
                  <figure class="blog-post-figure">
                    <OptimizedBlogImage
                      src={image.src}
                      alt={image.alt}
                      sizes={BLOG_POST_IMAGE_SIZES}
                      widths={BLOG_POST_IMAGE_WIDTHS}
                    />
                  </figure>
                ))}
                {section.imagePlacement !== "after-title" && section.imageSrc ? (
                  <figure class={getFigureClass(section)}>
                    <OptimizedBlogImage
                      src={section.imageSrc}
                      alt={section.imageAlt ?? ""}
                      sizes={BLOG_POST_IMAGE_SIZES}
                      widths={BLOG_POST_IMAGE_WIDTHS}
                    />
                  </figure>
                ) : null}
              </section>
            ))
          }
        </div>
      </div>
    </article>

    <section class="blog-related">
      <h2>Related posts</h2>
      <div class="blog-related-grid">
        {
          visibleRelatedPosts.map((relatedPost) => (
            <a href={`/blog/${relatedPost.slug}`}>
              <span>
                {relatedPost.date} - {relatedPost.category}
              </span>
              <h3>{relatedPost.title}</h3>
              <p>
                {relatedPost.readTime} <span aria-hidden="true">→</span>
              </p>
            </a>
          ))
        }
      </div>
      <a href="/blog" class="blog-more-link">
        View more posts <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>

  <SiteFooter links={blogFooterLinks} showContact={false} />
</div>
