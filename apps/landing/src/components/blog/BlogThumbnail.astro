---
import type { BlogPostSummary } from "../../landing/blog/blog-types";
import {
  BLOG_THUMBNAIL_IMAGE_SIZES,
  BLOG_THUMBNAIL_IMAGE_WIDTHS,
} from "./blog-image-presets";
import OptimizedBlogImage from "./OptimizedBlogImage.astro";

interface Props {
  post: BlogPostSummary;
  priority?: boolean;
}

const { post, priority = false } = Astro.props;
---

<div class="blog-image blog-image-card">
  <OptimizedBlogImage
    src={post.imageSrc}
    alt=""
    class="blog-image-media"
    priority={priority}
    sizes={BLOG_THUMBNAIL_IMAGE_SIZES}
    widths={BLOG_THUMBNAIL_IMAGE_WIDTHS}
  />
</div>
