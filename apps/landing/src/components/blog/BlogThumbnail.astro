---
import { thumbnailCells } from "../../landing/blog/blog-constants";
import type { BlogPostSummary } from "../../landing/blog/blog-posts";

interface Props {
  post: BlogPostSummary;
  variant?: "card" | "hero";
}

const { post, variant = "card" } = Astro.props;
---

{
  post.imageSrc ? (
    <div class={`blog-image blog-image-${variant}`}>
      <img
        src={post.imageSrc}
        alt=""
        class="blog-image-media"
        loading={variant === "hero" ? "eager" : "lazy"}
      />
    </div>
  ) : (
    <div class={`blog-image blog-image-${variant} ${post.thumbnail}`}>
      <div class="blog-image-inner">
        <div class="blog-image-bars">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="blog-image-symbols">
          <svg class="blog-image-icon" aria-hidden="true" viewBox="0 0 24 24">
            <path
              d="M5 5.5h14M5 12h14M5 18.5h9"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.8"
            ></path>
          </svg>
          <div class="blog-image-cells">
            {thumbnailCells.map(() => <span></span>)}
          </div>
        </div>
      </div>
    </div>
  )
}
