---
import type { BlogPostSection } from "../../landing/blog/blog-types";
import {
  BLOG_POST_IMAGE_SIZES,
  BLOG_POST_IMAGE_WIDTHS,
} from "./blog-image-presets";
import LinkedText from "./LinkedText.astro";
import OptimizedBlogImage from "./OptimizedBlogImage.astro";

interface Props {
  paragraph: string;
  paragraphIndex: number;
  section: BlogPostSection;
}

const { paragraph, paragraphIndex, section } = Astro.props;
const inlineImages = section.inlineImages.filter(
  (image) => image.beforeParagraphIndex === paragraphIndex
);
---

{
  inlineImages.map((image) => (
    <figure class="blog-post-figure blog-post-figure-inline">
      <OptimizedBlogImage
        src={image.src}
        alt={image.alt}
        sizes={BLOG_POST_IMAGE_SIZES}
        widths={BLOG_POST_IMAGE_WIDTHS}
      />
    </figure>
  ))
}
<p><LinkedText text={paragraph} /></p>
