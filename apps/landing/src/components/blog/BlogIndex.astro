---
import { BLOG_CATEGORY_FILTERS } from "../../landing/blog/blog-taxonomy";
import type { BlogCategoryFilter } from "../../landing/blog/blog-taxonomy";
import { comparePostDates } from "../../landing/blog/blog-collection";
import type { BlogPostSummary } from "../../landing/blog/blog-types";
import BlogThumbnail from "./BlogThumbnail.astro";

interface Props {
  posts: readonly BlogPostSummary[];
}

const { posts } = Astro.props;

const categoryParam = Astro.url.searchParams.get("category");
const activeCategoryFilter = BLOG_CATEGORY_FILTERS.includes(
  categoryParam as BlogCategoryFilter
)
  ? (categoryParam as BlogCategoryFilter)
  : "All";
const sortDirection =
  Astro.url.searchParams.get("sort") === "oldest" ? "Oldest" : "Latest";

const filteredPosts = posts
  .filter(
    (post) =>
      activeCategoryFilter === "All" || post.category === activeCategoryFilter
  )
  .toSorted((left, right) =>
    sortDirection === "Latest"
      ? comparePostDates(left, right)
      : comparePostDates(right, left)
  );

function createBlogHref(input: {
  category?: BlogCategoryFilter;
  sort?: typeof sortDirection;
}) {
  const category = input.category ?? activeCategoryFilter;
  const sort = input.sort ?? sortDirection;
  const params = new URLSearchParams();

  if (category !== "All") {
    params.set("category", category);
  }

  if (sort === "Oldest") {
    params.set("sort", "oldest");
  }

  const query = params.toString();
  return query ? `/blog?${query}` : "/blog";
}
---

<main class="blog-main">
    <section class="blog-index-hero">
      <p class="eyebrow">OneQuery</p>
      <h1>Blog</h1>
      <nav aria-label="Blog categories" class="blog-categories">
        {
          BLOG_CATEGORY_FILTERS.map((category) => (
            <a
              href={createBlogHref({ category })}
              class={
                activeCategoryFilter === category
                  ? "blog-category blog-category-active"
                  : "blog-category"
              }
              aria-current={activeCategoryFilter === category ? "page" : undefined}
            >
              {category}
            </a>
          ))
        }
      </nav>
    </section>

    <form class="blog-toolbar" aria-label="Blog filters" method="GET" action="/blog">
      {activeCategoryFilter === "All" ? null : <input type="hidden" name="category" value={activeCategoryFilter} />}
      <span class="blog-toolbar-button">{filteredPosts.length} posts</span>
      <label class="blog-toolbar-button">
        <span>Sort</span>
        <select name="sort">
          <option value="latest" selected={sortDirection === "Latest"}>Latest</option>
          <option value="oldest" selected={sortDirection === "Oldest"}>Oldest</option>
        </select>
      </label>
      <button type="submit" class="blog-toolbar-button">Apply</button>
    </form>

    <section>
      <div class="blog-grid">
        {
          filteredPosts.map((post, postIndex) => (
            <article class="blog-card">
              <a href={`/blog/${post.slug}`}>
                <BlogThumbnail post={post} priority={postIndex === 0} />
                <div class="blog-card-meta">
                  <span>{post.category}</span>
                  <span aria-hidden="true">/</span>
                  <span>{post.date}</span>
                </div>
                <h2>{post.title}</h2>
                <p>{post.description}</p>
                <span class="blog-card-read-more">
                  {post.readTime}
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            </article>
          ))
        }
      </div>
    </section>
 </main>
