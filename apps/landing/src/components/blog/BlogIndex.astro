---
import {
  BLOG_CATEGORY_FILTERS,
  BLOG_SORT_DIRECTIONS,
  getBlogIndexPath,
} from "../../landing/blog/blog-taxonomy";
import type {
  BlogCategoryFilter,
  BlogSortDirection,
} from "../../landing/blog/blog-taxonomy";
import type { BlogPostSummary } from "../../landing/blog/blog-types";
import BlogThumbnail from "./BlogThumbnail.astro";

interface Props {
  activeCategory: BlogCategoryFilter;
  posts: readonly BlogPostSummary[];
  sortDirection: BlogSortDirection;
}

const { activeCategory, posts, sortDirection } = Astro.props;
---

<main class="blog-main">
    <section class="blog-index-hero">
      <p class="eyebrow">OneQuery</p>
      <h1>Blog</h1>
      <nav aria-label="Blog categories" class="blog-categories">
        {
          BLOG_CATEGORY_FILTERS.map((category) => (
            <a
              href={getBlogIndexPath({ category, sortDirection: "Latest" })}
              class={
                activeCategory === category
                  ? "blog-category blog-category-active"
                  : "blog-category"
              }
              aria-current={activeCategory === category ? "page" : undefined}
            >
              {category}
            </a>
          ))
        }
      </nav>
    </section>

    <nav class="blog-toolbar" aria-label="Blog sort">
      <span class="blog-toolbar-button">{posts.length} posts</span>
      {
        BLOG_SORT_DIRECTIONS.map((nextSortDirection) => (
          <a
            href={getBlogIndexPath({
              category: activeCategory,
              sortDirection: nextSortDirection,
            })}
            class={
              sortDirection === nextSortDirection
                ? "blog-toolbar-button blog-toolbar-button-active"
                : "blog-toolbar-button"
            }
            aria-current={sortDirection === nextSortDirection ? "page" : undefined}
          >
            {nextSortDirection}
          </a>
        ))
      }
    </nav>

    <section>
      <div class="blog-grid">
        {
          posts.map((post, postIndex) => (
            <article class="blog-card">
              <a href={`/blog/${post.slug}`}>
                <BlogThumbnail post={post} priority={postIndex === 0} />
                <div class="blog-card-meta">
                  <span>{post.category}</span>
                  <span aria-hidden="true">/</span>
                  <span>{post.date}</span>
                </div>
                <h2>{post.title}</h2>
                <p>{post.description}</p>
                <span class="blog-card-read-more">
                  {post.readTime}
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            </article>
          ))
        }
      </div>
    </section>
 </main>
