---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  trackingHref?: string;
  trackingName?: string;
  trackingSection?: string;
}

const {
  trackingHref,
  trackingName,
  trackingSection,
  ...anchorAttributes
} = Astro.props;

const trackingAttributes =
  trackingName && trackingSection
    ? {
        "data-landing-cta": trackingName,
        "data-landing-cta-href": trackingHref ?? anchorAttributes.href,
        "data-landing-cta-section": trackingSection,
      }
    : {};
---

<a {...anchorAttributes} {...trackingAttributes}>
  <slot />
</a>
