---
import { googleTagConfig } from "../../landing/analytics/google-tag-config";
import {
  createGoogleTagAfterSwapScript,
  createGoogleTagBootstrapScript,
  createGoogleTagEventBridgeScript,
  createGoogleTagScriptSrc,
} from "../../landing/analytics/google-tag-script";

const scriptSrc = createGoogleTagScriptSrc(googleTagConfig);
const eventBridgeScript = createGoogleTagEventBridgeScript();
const bootstrapScript = createGoogleTagBootstrapScript(googleTagConfig);
const afterSwapScript = createGoogleTagAfterSwapScript(googleTagConfig);
---

<script is:inline set:html={eventBridgeScript} />
<script is:inline type="text/partytown" src={scriptSrc}></script>
<script is:inline type="text/partytown" set:html={bootstrapScript} />
<script is:inline set:html={afterSwapScript} />
