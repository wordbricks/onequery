---
import type { GoogleTagManagerConfig } from "../../landing/analytics/google-tag-manager-config";

type Props = Pick<GoogleTagManagerConfig, "domain" | "id">;

const { domain, id } = Astro.props;
const iframeSrc = `${domain.replace(/\/$/, "")}/ns.html?id=${encodeURIComponent(id)}`;
---

<noscript>
  <iframe
    src={iframeSrc}
    height="0"
    width="0"
    style="display:none;visibility:hidden"
  ></iframe>
</noscript>
