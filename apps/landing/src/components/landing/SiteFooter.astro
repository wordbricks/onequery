---
import { FOOTER_LINKS } from "../../landing/content/landing-content";
import { FooterContactButton } from "../../landing/marketing/footer-contact-button";
import TrackedLink from "./TrackedLink.astro";

type FooterLink = {
  href: string;
  label: string;
  trackingName?: string;
};

interface Props {
  links?: ReadonlyArray<FooterLink>;
  showContact?: boolean;
}

const {
  links = FOOTER_LINKS,
  showContact = true,
} = Astro.props;
---

<footer class="site-footer">
  <p>OneQuery</p>
  <div class="footer-links">
    {
      links.map((link) =>
        link.trackingName ? (
          <TrackedLink
            href={link.href}
            target="_blank"
            rel="noreferrer"
            trackingName={link.trackingName}
            trackingSection="footer"
          >
            {link.label}
          </TrackedLink>
        ) : (
          <a href={link.href} target="_blank" rel="noreferrer">
            {link.label}
          </a>
        )
      )
    }
    {
      showContact ? (
        <FooterContactButton client:visible={{ rootMargin: "400px 0px" }} />
      ) : null
    }
  </div>
</footer>
