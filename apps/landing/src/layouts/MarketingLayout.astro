---
import type { FooterLink } from "@/shared/navigation/footer";
import SiteFooter from "@/shared/components/Footer.astro";
import SiteHeader from "@/shared/components/Header.astro";
import BaseLayout from "./BaseLayout.astro";
import type { PageMetadata } from "./types";

interface Props extends PageMetadata {
  footerLinks?: ReadonlyArray<FooterLink>;
  shellClass?: string;
  showContact?: boolean;
}

const {
  footerLinks,
  shellClass = "page-shell",
  showContact = true,
  ...layoutProps
} = Astro.props;
---

<BaseLayout {...layoutProps}>
  <div class={shellClass}>
    <SiteHeader />
    <slot />
    <SiteFooter links={footerLinks} showContact={showContact} />
  </div>
</BaseLayout>
