---
import "@/shared/styles/base.css";
import SeoHead from "@onequery/astro-seo/SeoHead.astro";
import { Font } from "astro:assets";
import { googleTagConfig } from "@/shared/analytics/google-tag";
import {
  createGoogleTagAfterSwapScript,
  createGoogleTagBootstrapScript,
  createGoogleTagEventBridgeScript,
  createGoogleTagScriptSrc,
} from "@/shared/analytics/script";
import {
  createCanonicalUrl,
  createHomePageStructuredData,
  normalizeSiteUrl,
} from "@/shared/seo/schema";
import { ONEQUERY } from "@/shared/seo/constants";
import { getOneQueryShareImage } from "@/shared/seo/images";
import type { PageMetadata } from "./types";

const DEFAULT_TITLE = ONEQUERY.DEFAULT_PAGE_TITLE;
const DEFAULT_DESCRIPTION = ONEQUERY.SITE_DESCRIPTION;
const DEFAULT_KEYWORDS = ONEQUERY.DEFAULT_KEYWORDS;
const DEFAULT_IMAGE_ALT = ONEQUERY.SHARE_IMAGE_ALT;
const siteUrl = normalizeSiteUrl(Astro.site);
const DEFAULT_CANONICAL_URL = createCanonicalUrl("/", siteUrl);
const defaultShareImage = getOneQueryShareImage(siteUrl);
const googleTagScriptSrc = createGoogleTagScriptSrc(googleTagConfig);
const googleTagEventBridgeScript = createGoogleTagEventBridgeScript();
const googleTagBootstrapScript =
  createGoogleTagBootstrapScript(googleTagConfig);
const googleTagAfterSwapScript =
  createGoogleTagAfterSwapScript(googleTagConfig);
const DEFAULT_IMAGE_URL = defaultShareImage.url;
const DEFAULT_STRUCTURED_DATA = createHomePageStructuredData({
  description: DEFAULT_DESCRIPTION,
  image: {
    alt: DEFAULT_IMAGE_ALT,
    height: defaultShareImage.height,
    url: defaultShareImage.url,
    width: defaultShareImage.width,
  },
  site: siteUrl,
  title: DEFAULT_TITLE,
});

type Props = PageMetadata;

const {
  canonicalUrl = DEFAULT_CANONICAL_URL,
  description = DEFAULT_DESCRIPTION,
  imageAlt = DEFAULT_IMAGE_ALT,
  imageHeight = defaultShareImage.height,
  imageType = defaultShareImage.type,
  imageUrl = DEFAULT_IMAGE_URL,
  imageWidth = defaultShareImage.width,
  keywords = DEFAULT_KEYWORDS,
  metaTags = [],
  ogType = "website",
  robots = "index, follow, max-image-preview:large",
  structuredData = DEFAULT_STRUCTURED_DATA,
  title = DEFAULT_TITLE,
  ogTitle = title,
  twitterTitle = title,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      applicationName={ONEQUERY.NAME}
      appleMobileWebAppTitle={ONEQUERY.NAME}
      author={ONEQUERY.AUTHOR_NAME}
      canonicalUrl={canonicalUrl}
      description={description}
      image={{
        alt: imageAlt,
        height: imageHeight,
        type: imageType,
        url: imageUrl,
        width: imageWidth,
      }}
      keywords={keywords}
      metaTags={metaTags}
      openGraph={{
        locale: "en_US",
        siteName: ONEQUERY.NAME,
        title: ogTitle,
        type: ogType,
      }}
      robots={robots}
      sitemapUrl="/sitemap-index.xml"
      structuredData={structuredData}
      themeColor="#ffffff"
      title={title}
      twitter={{
        title: twitterTitle,
      }}
    />
    <script is:inline set:html={googleTagEventBridgeScript} />
    <script is:inline type="text/partytown" src={googleTagScriptSrc}></script>
    <script
      is:inline
      type="text/partytown"
      set:html={googleTagBootstrapScript}
    />
    <script is:inline set:html={googleTagAfterSwapScript} />
    <script is:inline>
      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) {
          return;
        }

        const target = event.target.closest("[data-landing-cta]");
        if (!(target instanceof HTMLElement)) {
          return;
        }

        const ctaId = target.dataset.landingCta;
        const ctaLocation = target.dataset.landingCtaSection;
        if (!ctaId || !ctaLocation) {
          return;
        }

        const destination =
          target.dataset.landingCtaHref ||
          (target instanceof HTMLAnchorElement ? target.href : undefined);

        if (typeof window.gtag !== "function") {
          return;
        }

        window.gtag("event", "landing_cta_click", {
          cta_id: ctaId,
          destination,
          location: ctaLocation,
        });
      });
    </script>
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/favicon-96x96.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    />
    <Font cssVariable="--font-geist" preload />
  </head>
  <body>
    <slot />
  </body>
</html>
