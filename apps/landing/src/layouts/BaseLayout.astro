---
import "../styles/base.css";
import { Font } from "astro:assets";
import GoogleTagManager from "../components/landing/GoogleTagManager.astro";
import GoogleTagManagerNoscript from "../components/landing/GoogleTagManagerNoscript.astro";
import { landingAnalyticsEnv } from "../landing/analytics/landing-analytics-env";
import { readGoogleTagManagerConfig } from "../landing/analytics/google-tag-manager-config";
import {
  createCanonicalUrl,
  createLandingPageStructuredData,
  normalizeSiteUrl,
  ONEQUERY_DEFAULT_DESCRIPTION,
  toAbsoluteSiteUrl,
} from "../landing/seo/structured-data";
import type { PageMetadata } from "./layout-types";

const DEFAULT_TITLE = "OneQuery | Governed Data Access for AI Agents";
const DEFAULT_DESCRIPTION = ONEQUERY_DEFAULT_DESCRIPTION;
const DEFAULT_KEYWORDS =
  "OneQuery, AI agent access control, production context, production keys, Claude Code, centralized credentials, audit logs, capability grants, safe production access";
const DEFAULT_IMAGE_ALT =
  "OneQuery - Governed Data Access for AI Agents";
const siteUrl = normalizeSiteUrl(Astro.site);
const DEFAULT_CANONICAL_URL = createCanonicalUrl("/", siteUrl);
const DEFAULT_IMAGE_URL = toAbsoluteSiteUrl("/og.png", siteUrl);
const DEFAULT_STRUCTURED_DATA = createLandingPageStructuredData({
  description: DEFAULT_DESCRIPTION,
  imageAlt: DEFAULT_IMAGE_ALT,
  imageUrl: DEFAULT_IMAGE_URL,
  site: siteUrl,
  title: DEFAULT_TITLE,
});

type Props = PageMetadata;

const {
  canonicalUrl = DEFAULT_CANONICAL_URL,
  description = DEFAULT_DESCRIPTION,
  imageAlt = DEFAULT_IMAGE_ALT,
  imageHeight = 630,
  imageUrl = DEFAULT_IMAGE_URL,
  imageWidth = 1200,
  keywords = DEFAULT_KEYWORDS,
  metaTags = [],
  ogType = "website",
  robots = "index, follow, max-image-preview:large",
  structuredData = DEFAULT_STRUCTURED_DATA,
  title = DEFAULT_TITLE,
  twitterTitle = title,
} = Astro.props;
const structuredDataItems =
  structuredData === null
    ? []
    : Array.isArray(structuredData)
      ? structuredData
      : [structuredData];
const googleTagManagerConfig = readGoogleTagManagerConfig(landingAnalyticsEnv);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    {
      googleTagManagerConfig ? (
        <>
          <GoogleTagManager {...googleTagManagerConfig} />
          <script is:inline>
            document.addEventListener("click", (event) => {
              if (!(event.target instanceof Element)) {
                return;
              }

              const target = event.target.closest("[data-landing-cta]");
              if (!(target instanceof HTMLElement)) {
                return;
              }

              const ctaId = target.dataset.landingCta;
              const ctaLocation = target.dataset.landingCtaSection;
              if (!ctaId || !ctaLocation) {
                return;
              }

              const destination =
                target.dataset.landingCtaHref ||
                (target instanceof HTMLAnchorElement ? target.href : undefined);

              if (!Array.isArray(window.dataLayer)) {
                return;
              }

              window.dataLayer.push({
                event: "landing_cta_click",
                cta_id: ctaId,
                destination,
                location: ctaLocation,
              });
            });
          </script>
        </>
      ) : null
    }
    <meta name="robots" content={robots} />
    <meta name="author" content="OneQuery Maintainers" />
    <meta name="application-name" content="OneQuery" />
    <meta name="apple-mobile-web-app-title" content="OneQuery" />
    <link rel="icon" type="image/png" href="/onequery-icon.png" />
    <link rel="apple-touch-icon" href="/onequery-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <Font cssVariable="--font-geist" preload />
    <meta name="description" content={description} />
    {keywords ? <meta name="keywords" content={keywords} /> : null}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="OneQuery" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {
      metaTags.map((tag) =>
        "name" in tag ? (
          <meta name={tag.name} content={tag.content} />
        ) : (
          <meta property={tag.property} content={tag.content} />
        )
      )
    }
    <title>{title}</title>
    {
      structuredDataItems.map((item) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(item)}
        />
      ))
    }
  </head>
  <body>
    {
      googleTagManagerConfig ? (
        <GoogleTagManagerNoscript {...googleTagManagerConfig} />
      ) : null
    }
    <slot />
  </body>
</html>
