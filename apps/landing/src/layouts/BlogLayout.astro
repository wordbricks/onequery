---
import { BLOG_FOOTER_LINKS } from "@/shared/navigation/footer";
import "@/features/blog/styles.css";
import MarketingLayout from "./MarketingLayout.astro";
import type { PageMetadata } from "./types";

type Props = PageMetadata;

const layoutProps = Astro.props;
---

<MarketingLayout
  {...layoutProps}
  footerLinks={BLOG_FOOTER_LINKS}
  shellClass="page-shell blog-shell"
  showContact={false}
>
  <slot />
</MarketingLayout>
