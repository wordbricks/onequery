---
import OneQueryIcon from "@/assets/onequery-icon.svg";
import { REPOSITORY_URL } from "@/shared/config/site";
import { BrandIcon } from "@/shared/icons/brands";
import TrackedLink from "./TrackedLink.astro";

type NavigationItem = {
  href: string;
  label: string;
};

const NAVIGATION_ITEMS = [
  { href: "/", label: "Product" },
  { href: "/#demo", label: "Demo" },
  { href: "/#install", label: "Install" },
  { href: "/compare/", label: "Compare" },
  { href: "/docs/", label: "Docs" },
  { href: "/connectors/", label: "Connectors" },
  { href: "/blog/", label: "Blog" },
] satisfies ReadonlyArray<NavigationItem>;

function normalizePathname(pathname: string) {
  if (pathname !== "/" && pathname.endsWith("/")) {
    return pathname.slice(0, -1);
  }

  return pathname;
}

const currentPathname = normalizePathname(Astro.url.pathname);

function isNavigationItemActive(item: NavigationItem) {
  const itemUrl = new URL(item.href, Astro.url);

  if (itemUrl.hash) {
    return false;
  }

  const itemPathname = normalizePathname(itemUrl.pathname);

  if (itemPathname === "/") {
    return currentPathname === "/";
  }

  return (
    currentPathname === itemPathname ||
    currentPathname.startsWith(`${itemPathname}/`)
  );
}

const navigationItems = NAVIGATION_ITEMS.map((item) => ({
  ...item,
  isActive: isNavigationItemActive(item),
}));
---

<header class="site-header">
  <TrackedLink
    href="/"
    class="brand-mark"
    aria-label="OneQuery landing homepage"
  >
    <OneQueryIcon
      aria-hidden="true"
      class="brand-mark-icon"
      width={60}
      height={60}
    />
    <span>OneQuery</span>
  </TrackedLink>

  <nav class="site-nav" aria-label="Primary">
    {
      navigationItems.map((item) => (
        <TrackedLink
          href={item.href}
          class:list={[
            "site-nav-link",
            { "site-nav-link-active": item.isActive },
          ]}
          aria-current={item.isActive ? "page" : undefined}
          trackingName="nav_section_link"
          trackingSection="header_nav"
        >
          {item.label}
        </TrackedLink>
      ))
    }
  </nav>

  <div class="header-actions">
    <TrackedLink
      class="header-github-link"
      href={REPOSITORY_URL}
      target="_blank"
      rel="noreferrer"
      aria-label="Open OneQuery GitHub repository"
      trackingName="header_github_repository"
      trackingSection="header"
    >
      <BrandIcon
        aria-hidden="true"
        className="header-github-link-icon"
        name="github"
      />
    </TrackedLink>
  </div>
</header>
