---
import { actions } from "astro:actions";
---

<button
  type="button"
  class="contact-link-button"
  data-contact-open
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="footer-contact-modal"
>
  Contact
</button>

<div
  class="contact-modal-backdrop"
  data-contact-backdrop
  role="presentation"
  hidden
>
  <div
    id="footer-contact-modal"
    class="contact-modal t-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="contact-modal-title"
    data-contact-modal
  >
    <button
      type="button"
      class="contact-modal-close"
      data-contact-close
      aria-label="Close contact form"
    >
      x
    </button>

    <div class="contact-modal-header">
      <p class="eyebrow">Start a conversation</p>
      <h2 id="contact-modal-title">Contact OneQuery</h2>
      <p class="contact-modal-copy">
        Tell us how you want agents to debug production. We can help with
        self-hosting, capability grants, and rollout questions.
      </p>
    </div>

    <form
      class="contact-modal-form t-input-wrap"
      action={actions.contact}
      method="post"
      data-contact-form
    >
      <div class="contact-modal-field-grid">
        <label class="contact-modal-field">
          <span class="contact-modal-label">Name</span>
          <input
            type="text"
            name="name"
            placeholder="Jane Doe"
            class="contact-modal-input t-input"
            maxlength="200"
            required
          />
        </label>

        <label class="contact-modal-field">
          <span class="contact-modal-label">Email</span>
          <input
            type="email"
            name="email"
            placeholder="you@company.com"
            class="contact-modal-input t-input"
            maxlength="320"
            required
          />
        </label>
      </div>

      <label class="contact-modal-field">
        <span class="contact-modal-label">Message</span>
        <textarea
          name="message"
          placeholder="Share your agent workflow, production systems, or timeline."
          class="contact-modal-textarea t-input"
          maxlength="4000"
          required></textarea>
      </label>

      <div class="contact-modal-actions">
        <p class="contact-modal-note">
          We use this only to follow up on your request.
        </p>
        <button type="submit" class="button button-primary contact-modal-submit">
          Send message
        </button>
        <p
          class="marketing-form-feedback marketing-form-feedback-error t-error-msg"
          data-contact-error
          aria-live="polite"
        >
          Failed to send message
        </p>
      </div>
    </form>
  </div>
</div>

<script>
  import { actions, isInputError } from "astro:actions";

  import { installFooterContactModal } from "./contact-modal";
  import type { ContactSubmissionResult } from "./contact-modal";

  function readContactActionErrorMessage(
    error: Awaited<ReturnType<typeof actions.contact>>["error"]
  ) {
    if (isInputError(error)) {
      return (
        error.fields.name?.[0] ??
        error.fields.email?.[0] ??
        error.fields.message?.[0] ??
        "Failed to send message"
      );
    }

    return error?.message ?? "Failed to send message";
  }

  installFooterContactModal({
    submit: async (formData): Promise<ContactSubmissionResult> => {
      const { error } = await actions.contact(formData);

      if (!error) {
        return { ok: true };
      }

      return {
        message: readContactActionErrorMessage(error),
        ok: false,
      };
    },
  });
</script>
