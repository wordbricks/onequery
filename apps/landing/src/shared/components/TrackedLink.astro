---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  trackingHref?: string;
  trackingName?: string;
  trackingSection?: string;
}

const {
  href,
  trackingHref,
  trackingName,
  trackingSection,
  ...anchorAttributes
} = Astro.props;
const trackingAttributes =
  trackingName && trackingSection
    ? {
        "data-landing-cta": trackingName,
        "data-landing-cta-href": trackingHref ?? href,
        "data-landing-cta-section": trackingSection,
      }
    : {};
---

<a href={href} {...anchorAttributes} {...trackingAttributes}>
  <slot />
</a>
