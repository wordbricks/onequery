---
import OneQueryIcon from "@/assets/onequery-icon.svg";
import { BrandIcon } from "@/shared/icons/brands";
import type { BrandIconName } from "@/shared/icons/brands";

type ControlPlaneInput = {
  key: string;
  kind: "human" | "bot";
  label: string;
};

type ControlPlaneOutput = {
  icons: readonly BrandIconName[];
  key: string;
  label: string;
};

const controlPlaneInputs = [
  { key: "member-a", kind: "human", label: "Engineer" },
  { key: "member-b", kind: "human", label: "Analyst" },
  { key: "member-c", kind: "bot", label: "CI agent" },
  { key: "member-d", kind: "bot", label: "AI agent" },
] satisfies ReadonlyArray<ControlPlaneInput>;

const controlPlaneOutputs = [
  {
    icons: ["postgresql", "mysql", "mongodb"],
    key: "database",
    label: "Databases",
  },
  {
    icons: ["bigquery", "snowflake"],
    key: "analytics",
    label: "Analytics",
  },
  {
    icons: ["notion", "googledrive"],
    key: "documents",
    label: "Internal docs",
  },
  {
    icons: ["github", "linear"],
    key: "code",
    label: "Code",
  },
] satisfies ReadonlyArray<ControlPlaneOutput>;

const controlPlanePolicies = [
  "Safe query screening",
  "Budget control",
  "Audit log",
  "Permission control",
] as const;
---

<div
  class="control-plane-diagram"
  role="img"
  aria-label="OneQuery sits between agents and tools on one side and databases, analytics, internal docs, and code on the other, applying safe query screening, budget control, audit logging, and permission control."
>
  <svg
    class="control-plane-diagram-lines"
    aria-hidden="true"
    preserveAspectRatio="none"
  >
    <line
      class="control-plane-line"
      x1="22%"
      y1="17.1%"
      x2="33.5%"
      y2="50%"
    ></line>
    <line
      class="control-plane-line control-plane-line-delay-1"
      x1="22%"
      y1="39%"
      x2="33.5%"
      y2="50%"
    ></line>
    <line
      class="control-plane-line control-plane-line-delay-2"
      x1="22%"
      y1="61%"
      x2="33.5%"
      y2="50%"
    ></line>
    <line
      class="control-plane-line control-plane-line-delay-3"
      x1="22%"
      y1="82.9%"
      x2="33.5%"
      y2="50%"
    ></line>
    <line
      class="control-plane-line control-plane-line-delay-2"
      x1="58.5%"
      y1="50%"
      x2="70%"
      y2="17.1%"
    ></line>
    <line
      class="control-plane-line"
      x1="58.5%"
      y1="50%"
      x2="70%"
      y2="39%"
    ></line>
    <line
      class="control-plane-line control-plane-line-delay-3"
      x1="58.5%"
      y1="50%"
      x2="70%"
      y2="61%"
    ></line>
    <line
      class="control-plane-line control-plane-line-delay-1"
      x1="58.5%"
      y1="50%"
      x2="70%"
      y2="82.9%"
    ></line>
  </svg>

  <div class="control-plane-column control-plane-column-left">
    {
      controlPlaneInputs.map((node, index) => (
        <div
          class={`control-plane-member-wrap control-plane-member-index-${index + 1}`}
        >
          <article class="control-plane-member" aria-label={node.label}>
            {node.kind === "human" ? (
              <svg
                class="control-plane-member-icon"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <circle cx="12" cy="8" r="3.25"></circle>
                <path d="M5.5 18.25C6.5 14.95 8.82 13.3 12 13.3C15.18 13.3 17.5 14.95 18.5 18.25"></path>
              </svg>
            ) : (
              <svg
                class="control-plane-member-icon"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <rect x="6" y="7" width="12" height="9" rx="2.5"></rect>
                <path d="M12 7V4.75"></path>
                <path d="M8.75 16V18.75"></path>
                <path d="M15.25 16V18.75"></path>
                <circle
                  cx="10"
                  cy="11.5"
                  r="0.85"
                  fill="currentColor"
                  stroke="none"
                ></circle>
                <circle
                  cx="14"
                  cy="11.5"
                  r="0.85"
                  fill="currentColor"
                  stroke="none"
                ></circle>
                <path d="M10 14H14"></path>
              </svg>
            )}
          </article>
          <span class="control-plane-member-label">{node.label}</span>
        </div>
      ))
    }
  </div>

  <div class="control-plane-core">
    <div class="control-plane-core-shell">
      <p class="control-plane-core-kicker">Unified control plane</p>
      <div class="control-plane-core-brand">
        <OneQueryIcon
          aria-hidden="true"
          class="control-plane-core-logo"
          width={96}
          height={96}
        />
        <h3>OneQuery</h3>
      </div>
      <div class="control-plane-capability-list">
        {
          controlPlanePolicies.map((policy) => (
            <div class="control-plane-capability-row">
              <span class="control-plane-capability-dot" aria-hidden="true" />
              <span>{policy}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="control-plane-column control-plane-column-right">
    {
      controlPlaneOutputs.map((node, index) => (
        <article
          class={`control-plane-node control-plane-node-output control-plane-output-index-${index + 1}`}
        >
          <span class="control-plane-node-label">{node.label}</span>
          <div class="control-plane-node-icons">
            {node.icons.map((icon) => (
              <BrandIcon className="brand-icon" name={icon} />
            ))}
          </div>
        </article>
      ))
    }
  </div>
</div>

<style>
  .control-plane-diagram {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 2.4fr 1.4fr;
    grid-template-rows: repeat(4, minmax(0, 1fr));
    justify-content: center;
    column-gap: 0;
    align-items: center;
    min-height: 340px;
    padding: 20px 24px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.012),
      rgba(0, 0, 0, 0.004)
    );
    box-shadow: var(--shadow-ring);
  }

  .control-plane-diagram-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .control-plane-line {
    fill: none;
    stroke: rgba(0, 0, 0, 0.22);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 5 9;
    animation: control-plane-flow 3.2s linear infinite;
  }

  .control-plane-column,
  .control-plane-core {
    position: relative;
    z-index: 1;
  }

  .control-plane-column {
    display: grid;
    grid-template-rows: repeat(4, minmax(0, 1fr));
    grid-row: 1 / span 4;
    align-self: stretch;
    align-items: center;
    gap: 0;
  }

  .control-plane-column-left {
    justify-items: end;
  }

  .control-plane-column-right {
    justify-items: start;
  }

  .control-plane-node {
    width: min(100%, 184px);
    min-height: 56px;
    padding: 11px 13px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: var(--shadow-ring);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .control-plane-node:hover,
  .control-plane-member:hover,
  .control-plane-core-shell:hover {
    border-color: var(--line-strong);
    box-shadow:
      0 16px 30px rgba(0, 0, 0, 0.06),
      var(--shadow-ring);
    transform: translateY(-1px);
  }

  .control-plane-member-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-self: end;
  }

  .control-plane-member {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: var(--shadow-ring);
    color: var(--ink);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .control-plane-member-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: 0;
    white-space: nowrap;
    order: -1;
  }

  .control-plane-member-icon {
    width: 20px;
    height: 20px;
    color: var(--ink);
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .control-plane-node-output {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 10px 14px;
    min-height: 52px;
  }

  .control-plane-node-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-soft);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .control-plane-node-icons {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: nowrap;
  }

  .control-plane-node-icons :global(.brand-icon) {
    width: 24px;
    height: 24px;
    flex: none;
    color: var(--ink);
  }

  .control-plane-core-shell h3,
  .control-plane-capability-row,
  .control-plane-core-kicker {
    margin: 0;
  }

  .control-plane-core-kicker {
    color: var(--text-soft);
    font-size: 11px;
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .control-plane-core {
    display: flex;
    justify-content: center;
    align-items: center;
    grid-row: 1 / span 4;
  }

  .control-plane-core-shell {
    width: min(100%, 300px);
    padding: 18px 18px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow-ring);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .control-plane-core-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
  }

  .control-plane-core-brand :global(.control-plane-core-logo) {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    object-fit: cover;
    flex: none;
  }

  .control-plane-core-shell h3 {
    margin: 0;
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
  }

  .control-plane-capability-list {
    display: grid;
    gap: 0;
    margin-top: 14px;
    padding: 2px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .control-plane-capability-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 38px;
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .control-plane-capability-row:first-child {
    border-top: 0;
  }

  .control-plane-capability-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--ink);
    animation: marker-pulse 2.4s ease-in-out infinite;
  }

  @keyframes control-plane-flow {
    to {
      stroke-dashoffset: -28;
    }
  }

  @keyframes marker-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }

    50% {
      opacity: 0.72;
      transform: scale(0.86);
    }
  }

  @media (max-width: 1100px) {
    .control-plane-diagram {
      grid-template-columns: 1fr 2.2fr 1.4fr;
      min-height: 340px;
      padding-inline: 20px;
    }

    .control-plane-core-shell {
      width: min(100%, 340px);
    }

    .control-plane-node {
      width: min(100%, 196px);
    }
  }

  @media (max-width: 860px) {
    .control-plane-diagram {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      justify-content: stretch;
      column-gap: 0;
      gap: 20px;
      min-height: auto;
      padding: 24px 18px;
    }

    .control-plane-diagram-lines {
      display: none;
    }

    .control-plane-column {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      grid-row: auto;
      gap: 14px;
    }

    .control-plane-column-right,
    .control-plane-column-left {
      justify-items: stretch;
    }

    .control-plane-node,
    .control-plane-column-right .control-plane-output-index-1,
    .control-plane-column-right .control-plane-output-index-2,
    .control-plane-column-right .control-plane-output-index-3,
    .control-plane-column-right .control-plane-output-index-4 {
      width: 100%;
      transform: none;
    }

    .control-plane-member-wrap {
      flex-direction: column;
      justify-self: center;
    }

    .control-plane-member-label {
      order: 0;
    }

    .control-plane-member {
      width: 52px;
      height: 52px;
      transform: none;
    }

    .control-plane-core-shell {
      width: 100%;
    }

    .control-plane-core {
      grid-row: auto;
    }
  }

  @media (max-width: 640px) {
    .control-plane-column {
      grid-template-columns: 1fr;
    }

    .control-plane-column-left {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
    }

    .control-plane-column-right {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .control-plane-member-wrap {
      justify-self: stretch;
      align-items: center;
      gap: 8px;
    }

    .control-plane-member-label {
      font-size: 11px;
      line-height: 1.25;
      text-align: center;
      white-space: normal;
    }

    .control-plane-node {
      min-height: 72px;
    }

    .control-plane-core-shell {
      padding: 22px 18px 18px;
      border-radius: 18px;
    }

    .control-plane-core-shell h3 {
      font-size: 2.7rem;
    }

    .control-plane-capability-list {
      margin-top: 20px;
    }

    .control-plane-capability-row {
      min-height: 46px;
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .control-plane-line,
    .control-plane-node,
    .control-plane-core-shell,
    .control-plane-capability-dot {
      animation: none;
    }

    .control-plane-node,
    .control-plane-member,
    .control-plane-core-shell {
      transition: none;
    }
  }
</style>
