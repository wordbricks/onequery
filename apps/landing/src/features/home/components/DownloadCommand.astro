---
import { Code } from "astro:components";

import {
  COPY_FEEDBACK_RESET_DELAY_MS,
  INSTALL_COMMANDS,
} from "@/shared/config/site";
import { BrandIcon } from "@/shared/icons/brands";

const defaultMethod = INSTALL_COMMANDS[0];

function getInstallTabId(index: number) {
  return `install-tab-${index}`;
}
---

<div
  class="install-selector"
  data-install-selector
  data-copy-reset-delay={COPY_FEEDBACK_RESET_DELAY_MS}
>
  <div class="install-tabs" role="tablist" aria-label="Install method">
    {
      INSTALL_COMMANDS.map((method, index) => (
        <button
          id={getInstallTabId(index)}
          type="button"
          role="tab"
          aria-selected={method === defaultMethod ? "true" : "false"}
          aria-controls="install-command-panel"
          class:list={[
            "install-tab",
            method === defaultMethod && "install-tab-active",
          ]}
          data-install-method-index={index}
          data-install-method-label={method.label}
          data-install-method-command={method.command}
        >
          <BrandIcon
            aria-hidden="true"
            className="install-tab-icon"
            name={method.iconName}
          />
          {method.label}
        </button>
      ))
    }
  </div>

  <div
    id="install-command-panel"
    class="download-command"
    role="tabpanel"
    aria-labelledby={getInstallTabId(0)}
  >
    <div class="download-command-line">
      <code class="download-command-label" aria-hidden="true">$</code>
      {
        INSTALL_COMMANDS.map((method, index) => (
          <span
            class="download-command-value"
            data-install-command-value
            data-install-method-index={index}
            hidden={method !== defaultMethod}
          >
            <Code
              class="download-command-code"
              code={method.command}
              defaultColor={false}
              inline
              lang="shell"
              theme="tokyo-night"
            />
          </span>
        ))
      }
    </div>
    <button
      type="button"
      class="install-method-copy"
      aria-label={`Copy ${defaultMethod.label} install command`}
      data-install-copy-button
    >
      <span class="t-text-swap" aria-live="polite" data-install-copy-text>
        Copy
      </span>
    </button>
  </div>
</div>

<style>
  .install-selector {
    display: grid;
    gap: 12px;
    width: min(100%, 780px);
    margin-top: 28px;
  }

  .install-tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .install-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    padding: 0 10px 0 8px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--text-soft);
    font-size: 12px;
    font-weight: 500;
    line-height: 18px;
    cursor: pointer;
  }

  .install-tab :global(.install-tab-icon) {
    display: block;
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
    color: currentColor;
  }

  .install-tab-active {
    background: var(--wash);
    color: var(--ink);
  }

  .download-command {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 8px;
    border: 1px solid rgba(0, 0, 0, 0.24);
    border-radius: 16px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.045), transparent 100%),
      #0d0d0d;
    box-shadow:
      0 18px 42px rgba(0, 0, 0, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .download-command:focus-within,
  .download-command:hover {
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow:
      0 22px 48px rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
  }

  .download-command-line {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    min-height: 44px;
    padding: 0 6px;
  }

  .download-command-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.74);
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
  }

  .download-command-value {
    display: block;
    min-width: 0;
    overflow: hidden;
    color: rgba(255, 255, 255, 0.92);
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 15px;
    font-weight: 600;
    line-height: 22px;
  }

  .download-command-value[hidden] {
    display: none;
  }

  .download-command-value :global(.download-command-code) {
    display: block;
    min-width: 0;
    overflow: hidden;
    background: transparent !important;
    font: inherit;
    line-height: inherit;
    white-space: inherit;
    text-overflow: inherit;
  }

  .download-command-value :global(.line) {
    display: inline;
  }

  .install-method-copy {
    min-width: 74px;
    min-height: 42px;
    padding: 0 14px;
    border: 0;
    border-radius: 11px;
    background: var(--surface);
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    line-height: 19px;
    box-shadow:
      0 10px 20px rgba(0, 0, 0, 0.2),
      inset 0 0 0 1px rgba(255, 255, 255, 0.22);
    cursor: pointer;
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .install-method-copy:hover {
    opacity: 0.94;
    box-shadow:
      0 12px 24px rgba(0, 0, 0, 0.24),
      inset 0 0 0 1px rgba(255, 255, 255, 0.24);
    transform: translateY(-1px);
  }

  .t-text-swap {
    display: inline-block;
    transform: translateY(0);
    filter: blur(0);
    opacity: 1;
    transition:
      transform var(--text-swap-dur) var(--text-swap-ease),
      filter var(--text-swap-dur) var(--text-swap-ease),
      opacity var(--text-swap-dur) var(--text-swap-ease);
    will-change: transform, filter, opacity;
  }

  .t-text-swap.is-exit {
    transform: translateY(calc(var(--text-swap-translate-y) * -1));
    filter: blur(var(--text-swap-blur));
    opacity: 0;
  }

  .t-text-swap.is-enter-start {
    transform: translateY(var(--text-swap-translate-y));
    filter: blur(var(--text-swap-blur));
    opacity: 0;
    transition: none;
  }

  @media (max-width: 640px) {
    .download-command {
      grid-template-columns: 1fr;
      align-items: stretch;
    }

    .download-command-line {
      min-height: 42px;
    }

    .download-command-value {
      overflow: visible;
      white-space: normal;
      text-overflow: clip;
      word-break: break-word;
    }

    .download-command-value :global(.download-command-code) {
      overflow: visible;
      word-break: inherit;
    }

    .install-method-copy {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .download-command,
    .install-method-copy {
      transition: none;
    }

    .t-text-swap {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const selectors = document.querySelectorAll("[data-install-selector]");

    function trackEvent(eventName, params) {
      if (typeof window.gtag !== "function") {
        return;
      }

      window.gtag("event", eventName, params);
    }

    function swapText(element, nextText) {
      if (!element || element.textContent === nextText) {
        return;
      }

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        element.textContent = nextText;
        return;
      }

      element.classList.add("is-exit");
      window.setTimeout(() => {
        element.textContent = nextText;
        element.classList.remove("is-exit");
        element.classList.add("is-enter-start");

        window.requestAnimationFrame(() => {
          element.classList.remove("is-enter-start");
        });
      }, 120);
    }

    for (const selector of selectors) {
      const tabs = Array.from(
        selector.querySelectorAll("[data-install-method-index]")
      );
      const panel = selector.querySelector("#install-command-panel");
      const commands = Array.from(
        selector.querySelectorAll("[data-install-command-value]")
      );
      const copyButton = selector.querySelector("[data-install-copy-button]");
      const copyText = selector.querySelector("[data-install-copy-text]");
      const resetDelay =
        Number(selector.getAttribute("data-copy-reset-delay")) || 1500;
      let selectedTab = tabs.find(
        (tab) => tab.getAttribute("aria-selected") === "true"
      );
      let resetTimer;

      const readTab = (tab) => ({
        command: tab.getAttribute("data-install-method-command") || "",
        id: tab.id,
        index: tab.getAttribute("data-install-method-index") || "",
        label: tab.getAttribute("data-install-method-label") || "",
        tab,
      });

      const updateCopyButton = (text) => {
        const selected = selectedTab ? readTab(selectedTab) : undefined;

        if (!copyButton || !copyText || !selected) {
          return;
        }

        copyButton.setAttribute(
          "aria-label",
          text === "Copied"
            ? `${selected.label} install command copied`
            : `Copy ${selected.label} install command`
        );
        swapText(copyText, text);
      };

      const clearResetTimer = () => {
        if (resetTimer !== undefined) {
          window.clearTimeout(resetTimer);
          resetTimer = undefined;
        }
      };

      const resetCopyFeedback = () => {
        clearResetTimer();
        updateCopyButton("Copy");
      };

      const selectTab = (tab, shouldTrack) => {
        const selected = readTab(tab);

        selectedTab = tab;

        for (const candidate of tabs) {
          const isSelected = candidate === tab;
          candidate.setAttribute("aria-selected", String(isSelected));
          candidate.classList.toggle("install-tab-active", isSelected);
        }

        if (panel) {
          panel.setAttribute("aria-labelledby", selected.id);
        }

        for (const command of commands) {
          command.hidden =
            command.getAttribute("data-install-method-index") !==
            selected.index;
        }

        resetCopyFeedback();

        if (shouldTrack) {
          trackEvent("landing_install_method_selected", {
            method: selected.label,
          });
        }
      };

      for (const tab of tabs) {
        tab.addEventListener("click", () => {
          selectTab(tab, true);
        });
      }

      copyButton?.addEventListener("click", async () => {
        if (!selectedTab) {
          return;
        }

        const selected = readTab(selectedTab);

        try {
          await navigator.clipboard.writeText(selected.command);
          updateCopyButton("Copied");
          trackEvent("landing_install_command_copied", {
            method: selected.label,
          });
          clearResetTimer();
          resetTimer = window.setTimeout(resetCopyFeedback, resetDelay);
        } catch {
          resetCopyFeedback();
        }
      });
    }
  })();
</script>
