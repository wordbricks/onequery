---
import {
  HERO_PRODUCT_TAB_ORDER,
  HERO_TAB_DWELL_MS,
  SAFE_QUERY_INITIAL_DELAY_MS,
  SAFE_QUERY_RESULT_HOLD_MS,
  SAFE_QUERY_STEP_DELAY_MS,
  heroProductAuditEntries,
  heroProductIntegrationRows,
  heroProductTabMeta,
  heroProductTabs,
  heroSafeQueryChecks,
} from "@/features/home/hero/store";
import type { HeroProductTab } from "@/features/home/hero/store";

const initialTab: HeroProductTab = "integrations";
const initialTabMeta = heroProductTabMeta[initialTab];
---

<div
  class="hero-product-surface"
  aria-label="OneQuery product overview"
  data-hero-product-surface
  data-hero-initial-tab={initialTab}
  data-hero-tab-order={HERO_PRODUCT_TAB_ORDER.join(",")}
  data-hero-dwell-integrations={HERO_TAB_DWELL_MS.integrations}
  data-hero-dwell-query={HERO_TAB_DWELL_MS.query}
  data-hero-dwell-audit={HERO_TAB_DWELL_MS.audit}
  data-hero-safe-initial-delay={SAFE_QUERY_INITIAL_DELAY_MS}
  data-hero-safe-step-delay={SAFE_QUERY_STEP_DELAY_MS}
  data-hero-safe-result-hold={SAFE_QUERY_RESULT_HOLD_MS}
>
  <aside class="hero-product-sidebar">
    <div class="hero-product-brand">
      <span class="hero-product-brand-mark" aria-hidden="true"></span>
      <div>
        <p>OneQuery</p>
        <span>acme-org</span>
      </div>
    </div>

    <div class="hero-product-nav">
      {
        heroProductTabs.map((tab) => (
          <button
            type="button"
            class:list={[
              "hero-product-nav-button",
              tab.id === initialTab && "hero-product-nav-active",
            ]}
            aria-pressed={tab.id === initialTab ? "true" : "false"}
            data-hero-product-tab={tab.id}
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    <div class="hero-product-sidebar-footer">audited</div>
  </aside>

  <div class="hero-product-main">
    <div class="hero-product-header">
      <div>
        <h3>prod-debug-readonly</h3>
        <p>Context without secrets.</p>
      </div>
      <div class="hero-product-header-meta">
        <span>4 sources</span>
        <span>keys hidden</span>
      </div>
    </div>

    <section class="hero-product-focus">
      <div class="hero-product-section-header">
        <h4 data-hero-product-title>{initialTabMeta.title}</h4>
        <span data-hero-product-tag>{initialTabMeta.tag}</span>
      </div>
      <div class="hero-product-panel-body" data-hero-product-panel-body>
        <div
          class="hero-product-panel t-panel-slide"
          data-open="true"
          data-tab="integrations"
        >
          <div class="hero-product-list">
            {
              heroProductIntegrationRows.map((row) => (
                <div class="hero-product-row">
                  <span>{row.source}</span>
                  <span>{row.provider}</span>
                  <span>{row.status}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </div>

  <template
    data-hero-product-panel-template="integrations"
    data-hero-product-title={heroProductTabMeta.integrations.title}
    data-hero-product-tag={heroProductTabMeta.integrations.tag}
  >
    <div
      class="hero-product-panel t-panel-slide"
      data-open="false"
      data-tab="integrations"
    >
      <div class="hero-product-list">
        {
          heroProductIntegrationRows.map((row) => (
            <div class="hero-product-row">
              <span>{row.source}</span>
              <span>{row.provider}</span>
              <span>{row.status}</span>
            </div>
          ))
        }
      </div>
    </div>
  </template>

  <template
    data-hero-product-panel-template="query"
    data-hero-product-title={heroProductTabMeta.query.title}
    data-hero-product-tag={heroProductTabMeta.query.tag}
  >
    <div
      class="hero-product-panel t-panel-slide"
      data-open="false"
      data-tab="query"
    >
      <div
        class="hero-safe-query"
        data-result="pending"
        aria-label="Capability grant policy checks"
      >
        <div class="hero-safe-query-preview">
          <span
            class="hero-safe-query-preview-line hero-safe-query-preview-line-primary"
          >
            read sentry
          </span>
          <span class="hero-safe-query-preview-line">select orders</span>
          <span class="hero-safe-query-preview-line">write PR</span>
        </div>

        <div class="hero-safe-query-sidebar">
          <div class="hero-safe-query-checklist" aria-live="polite">
            {
              heroSafeQueryChecks.map((check) => (
                <div
                  class="hero-safe-query-check"
                  data-status="pending"
                  data-hero-safe-query-check={check.id}
                >
                  <span
                    class="hero-safe-query-check-box"
                    aria-hidden="true"
                    data-hero-safe-query-check-box
                  >
                  </span>
                  <span>{check.label}</span>
                </div>
              ))
            }
          </div>

          <div class="hero-safe-query-result-wrap">
            <div
              class="hero-safe-query-result"
              data-result="pending"
              data-hero-safe-query-result
            >
              <span
                class="hero-safe-query-result-text t-text-swap"
                aria-live="polite"
                data-hero-safe-query-result-text
              >
                CHECKING
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </template>

  <template
    data-hero-product-panel-template="audit"
    data-hero-product-title={heroProductTabMeta.audit.title}
    data-hero-product-tag={heroProductTabMeta.audit.tag}
  >
    <div
      class="hero-product-panel t-panel-slide"
      data-open="false"
      data-tab="audit"
    >
      <div class="hero-product-audit">
        {
          heroProductAuditEntries.map((entry) => (
            <div class="hero-product-audit-item">
              <span class="hero-product-audit-dot" aria-hidden="true"></span>
              <div>
                <p>{entry.text}</p>
                <span>{entry.detail}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </template>
</div>

<style>
  .hero-product-surface {
    position: relative;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    width: 100%;
    min-height: 360px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--shadow), var(--shadow-ring);
    opacity: 0;
    transform: translateY(18px);
    animation: surface-enter 720ms cubic-bezier(0.22, 1, 0.36, 1) 80ms
      forwards;
  }

  .hero-product-sidebar {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 24px;
    padding: 20px 16px;
    border-right: 1px solid var(--line);
    background: rgba(0, 0, 0, 0.02);
  }

  .hero-product-brand,
  .hero-product-audit-item,
  .hero-product-row {
    display: flex;
    align-items: center;
  }

  .hero-product-brand {
    gap: 10px;
  }

  .hero-product-brand-mark {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--ink);
  }

  .hero-product-brand p,
  .hero-product-brand span,
  .hero-product-section-header h4,
  .hero-product-audit-item p,
  .hero-product-audit-item span,
  .hero-product-sidebar-footer {
    margin: 0;
  }

  .hero-product-brand p {
    font-size: 13px;
    font-weight: 600;
  }

  .hero-product-brand span,
  .hero-product-sidebar-footer {
    color: var(--text-soft);
    font-size: 11px;
    line-height: 1.5;
  }

  .hero-product-sidebar-footer {
    margin-top: auto;
  }

  .hero-product-nav {
    display: grid;
    gap: 8px;
    margin-top: 4px;
  }

  .hero-product-nav-button {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 10px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--text-soft);
    font-size: 12px;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }

  .hero-product-nav-active {
    background: var(--wash);
    color: var(--ink);
  }

  .hero-product-main {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 16px;
    padding: 22px 24px 22px;
  }

  .hero-product-header,
  .hero-product-section-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .hero-product-header h3,
  .hero-product-section-header h4 {
    color: var(--ink);
    letter-spacing: 0;
  }

  .hero-product-header h3 {
    margin: 0;
    font-size: 24px;
    font-weight: 650;
  }

  .hero-product-header p,
  .hero-product-header-meta,
  .hero-product-section-header span,
  .hero-product-row,
  .hero-product-audit-item span {
    color: var(--text-soft);
    font-size: 12px;
    line-height: 1.5;
  }

  .hero-product-header p {
    margin: 6px 0 0;
  }

  .hero-product-header-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .hero-product-header-meta span,
  .hero-product-section-header span {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 10px;
    border-radius: 10px;
    background: var(--wash);
  }

  .hero-product-focus {
    display: grid;
    grid-template-rows: auto 208px;
    gap: 14px;
    padding: 18px 0 0;
    border-top: 1px solid var(--line);
  }

  .hero-product-panel-body {
    height: 208px;
    overflow: hidden;
  }

  .t-panel-slide {
    transform: translateY(var(--panel-translate-y));
    opacity: 0;
    filter: blur(var(--panel-blur));
    pointer-events: none;
    transition:
      transform var(--panel-close-dur) var(--panel-ease),
      opacity var(--panel-close-dur) var(--panel-ease),
      filter var(--panel-close-dur) var(--panel-ease);
    will-change: transform, opacity, filter;
  }

  .t-panel-slide[data-open="true"] {
    transform: translateY(0);
    opacity: 1;
    filter: blur(0);
    pointer-events: auto;
    transition:
      transform var(--panel-open-dur) var(--panel-ease),
      opacity var(--panel-open-dur) var(--panel-ease),
      filter var(--panel-open-dur) var(--panel-ease);
  }

  .hero-safe-query-check-box :global(.t-success-check) {
    display: inline-block;
    transform-origin: center;
    opacity: 0;
    will-change: transform, opacity, filter;
  }

  .hero-safe-query-check-box :global(.t-success-check svg) {
    display: block;
    overflow: visible;
  }

  .hero-safe-query-check-box :global(.t-success-check svg path) {
    stroke-dasharray: 20;
    stroke-dashoffset: 20;
  }

  .hero-safe-query-check-box :global(.t-success-check[data-state="in"]) {
    animation:
      t-check-fade var(--check-opacity-dur) var(--check-ease-opacity) forwards,
      t-check-rotate var(--check-rotate-dur) var(--check-ease-rotate) forwards,
      t-check-blur var(--check-blur-dur) var(--check-ease-out) forwards,
      t-check-bob var(--check-bob-dur) var(--check-ease-bob) forwards;
  }

  .hero-safe-query-check-box
    :global(.t-success-check[data-state="in"] svg path) {
    animation: t-check-draw var(--check-path-dur) var(--check-ease-path)
      var(--check-path-delay, 0ms) forwards;
  }

  .hero-product-panel {
    --panel-translate-y: 10px;
    min-height: 100%;
  }

  .hero-product-list,
  .hero-product-audit {
    display: grid;
    gap: 0;
    min-height: 100%;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .hero-product-row {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    font-size: 12px;
  }

  .hero-product-row span:last-child {
    justify-self: end;
    text-align: right;
  }

  .hero-product-row:first-child,
  .hero-product-audit-item:first-child {
    border-top: 0;
  }

  .hero-safe-query {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(164px, 0.82fr);
    gap: 18px;
    min-height: 100%;
    padding: 4px 0 0;
  }

  .hero-safe-query-preview,
  .hero-safe-query-result {
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: linear-gradient(180deg, #fff 0%, rgba(0, 0, 0, 0.01) 100%);
  }

  .hero-safe-query-preview {
    display: grid;
    align-content: start;
    gap: 14px;
    min-height: 100%;
    padding: 18px 20px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.45);
  }

  .hero-safe-query-preview-line {
    color: rgba(10, 10, 10, 0.74);
    font-family:
      "SFMono-Regular", ui-monospace, "Cascadia Code", "Source Code Pro",
      Menlo, Consolas, monospace;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    opacity: 0;
    transform: translateY(8px);
    animation: hero-item-enter 360ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-safe-query-preview-line-primary {
    margin-top: 4px;
    color: var(--ink);
    font-size: 15px;
  }

  .hero-safe-query-sidebar {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 16px;
    padding-top: 8px;
  }

  .hero-safe-query-checklist {
    display: grid;
    align-content: start;
    gap: 14px;
  }

  .hero-safe-query-check {
    display: flex;
    align-items: center;
    gap: 12px;
    color: rgba(10, 10, 10, 0.82);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0;
    opacity: 0;
    transform: translateY(6px);
    animation: hero-item-enter 360ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-safe-query-check-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 24px;
    height: 24px;
    border: 1px solid var(--line-strong);
    border-radius: 7px;
    background: #fff;
    color: transparent;
    font-size: 14px;
    line-height: 1;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .hero-safe-query-check-box :global(.hero-safe-query-status-check) {
    --check-blur-from: 2px;
    --check-rotate-from: 28deg;
    --check-y-amount: 5px;
    color: var(--success);
  }

  .hero-safe-query-check-box :global(.hero-safe-query-status-check svg) {
    width: 14px;
    height: 14px;
  }

  .hero-safe-query-check-box :global(.hero-safe-query-status-check svg path) {
    stroke-dasharray: 15;
    stroke-dashoffset: 15;
  }

  .hero-safe-query-check[data-status="success"] .hero-safe-query-check-box {
    border-color: rgba(15, 118, 110, 0.55);
    background: var(--success-soft);
    color: var(--success);
    box-shadow: 0 10px 18px rgba(15, 118, 110, 0.1);
    transform: scale(1.04);
  }

  .hero-safe-query-check[data-status="failure"] .hero-safe-query-check-box {
    border-color: rgba(180, 35, 24, 0.52);
    background: var(--danger);
    color: #fff;
    box-shadow: 0 12px 22px rgba(180, 35, 24, 0.16);
    transform: scale(1.04);
  }

  .hero-safe-query-check[data-status="pending"] {
    color: var(--text-soft);
  }

  .hero-safe-query-result-wrap {
    display: flex;
    justify-content: flex-end;
  }

  .hero-safe-query-result {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 126px;
    min-height: 60px;
    padding: 0 18px;
    color: var(--ink);
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .hero-safe-query-result-text {
    min-width: 92px;
    text-align: center;
  }

  .hero-safe-query-result[data-result="pending"] {
    color: rgba(10, 10, 10, 0.56);
  }

  .hero-safe-query-result[data-result="pass"] {
    border-color: rgba(15, 118, 110, 0.46);
    background: var(--success-soft);
    color: var(--success);
    box-shadow: 0 14px 28px rgba(15, 118, 110, 0.12);
    transform: translateY(-1px);
  }

  .hero-safe-query-result[data-result="blocked"] {
    border-color: var(--danger);
    background: var(--danger);
    color: #fff;
    box-shadow: 0 18px 34px rgba(180, 35, 24, 0.18);
    transform: translateY(-1px);
  }

  .hero-product-audit-item {
    position: relative;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 0;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    opacity: 0;
    transform: translateY(6px);
    animation: hero-item-enter 360ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-product-audit-item p {
    position: relative;
    z-index: 1;
    color: var(--ink);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
  }

  .hero-product-audit-dot {
    position: relative;
    z-index: 1;
    flex: none;
    width: 5px;
    height: 5px;
    margin-top: 6px;
    border-radius: 999px;
    background: var(--ink);
  }

  .hero-product-row {
    position: relative;
    opacity: 0;
    transform: translateY(6px);
    animation: hero-item-enter 360ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-product-row span,
  .hero-product-audit-item > div {
    position: relative;
    z-index: 1;
  }

  .hero-product-row::after,
  .hero-product-audit-item::after {
    content: "";
    position: absolute;
    inset: 3px -8px;
    z-index: 0;
    border-radius: 8px;
    background: var(--success-soft);
    box-shadow: inset 3px 0 0 rgba(15, 118, 110, 0.38);
    opacity: 0;
    animation: access-flow 6.4s ease-in-out infinite;
  }

  .hero-product-row:nth-child(1),
  .hero-product-audit-item:nth-child(1) {
    animation-delay: 60ms;
  }

  .hero-product-row:nth-child(1)::after,
  .hero-product-audit-item:nth-child(1)::after {
    animation-delay: 0ms;
  }

  .hero-product-row:nth-child(2),
  .hero-product-audit-item:nth-child(2) {
    animation-delay: 110ms;
  }

  .hero-product-row:nth-child(2)::after,
  .hero-product-audit-item:nth-child(2)::after {
    animation-delay: 1.15s;
  }

  .hero-product-row:nth-child(3),
  .hero-product-audit-item:nth-child(3) {
    animation-delay: 160ms;
  }

  .hero-product-row:nth-child(3)::after,
  .hero-product-audit-item:nth-child(3)::after {
    animation-delay: 2.3s;
  }

  .hero-product-row:nth-child(4) {
    animation-delay: 210ms;
  }

  .hero-product-row:nth-child(4)::after {
    animation-delay: 3.45s;
  }

  .hero-safe-query-preview-line:nth-child(1),
  .hero-safe-query-check:nth-child(1) {
    animation-delay: 60ms;
  }

  .hero-safe-query-preview-line:nth-child(2),
  .hero-safe-query-check:nth-child(2) {
    animation-delay: 120ms;
  }

  .hero-safe-query-preview-line:nth-child(3),
  .hero-safe-query-check:nth-child(3) {
    animation-delay: 180ms;
  }

  .t-text-swap {
    display: inline-block;
    transform: translateY(0);
    filter: blur(0);
    opacity: 1;
    transition:
      transform var(--text-swap-dur) var(--text-swap-ease),
      filter var(--text-swap-dur) var(--text-swap-ease),
      opacity var(--text-swap-dur) var(--text-swap-ease);
    will-change: transform, filter, opacity;
  }

  .t-text-swap.is-exit {
    transform: translateY(calc(var(--text-swap-translate-y) * -1));
    filter: blur(var(--text-swap-blur));
    opacity: 0;
  }

  .t-text-swap.is-enter-start {
    transform: translateY(var(--text-swap-translate-y));
    filter: blur(var(--text-swap-blur));
    opacity: 0;
    transition: none;
  }

  @keyframes hero-item-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes surface-enter {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes access-flow {
    0%,
    18%,
    100% {
      opacity: 0;
    }

    5%,
    11% {
      opacity: 1;
    }
  }

  @keyframes t-check-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes t-check-rotate {
    from {
      transform: rotate(var(--check-rotate-from));
    }
    to {
      transform: rotate(0deg);
    }
  }

  @keyframes t-check-blur {
    from {
      filter: blur(var(--check-blur-from));
    }
    to {
      filter: blur(0);
    }
  }

  @keyframes t-check-bob {
    from {
      translate: 0 var(--check-y-amount);
    }
    to {
      translate: 0 0;
    }
  }

  @keyframes t-check-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 860px) {
    .hero-product-surface {
      grid-template-columns: 1fr;
    }

    .hero-product-focus {
      grid-template-rows: auto auto;
    }

    .hero-product-panel-body {
      height: auto;
      min-height: 208px;
      overflow: visible;
    }

    .hero-safe-query {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .hero-safe-query-sidebar {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: none;
      align-items: end;
      gap: 16px;
      padding-top: 0;
    }

    .hero-safe-query-result-wrap {
      justify-content: flex-start;
    }

    .hero-product-sidebar {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }

    .hero-product-header,
    .hero-product-section-header {
      flex-direction: column;
    }

    .hero-product-header-meta {
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .hero-product-surface {
      grid-template-columns: 1fr;
    }

    .hero-product-sidebar {
      display: none;
    }

    .hero-product-main {
      padding: 18px 16px 16px;
    }

    .hero-safe-query-sidebar {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      align-items: stretch;
    }

    .hero-safe-query-result-wrap {
      justify-content: stretch;
    }

    .hero-safe-query-result {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-product-surface,
    .hero-product-row::after,
    .hero-product-audit-item::after,
    .hero-safe-query-preview-line,
    .hero-safe-query-check {
      animation: none;
    }

    .hero-product-surface,
    .hero-safe-query-preview-line,
    .hero-safe-query-check {
      opacity: 1;
      transform: none;
    }

    .t-panel-slide,
    .t-text-swap {
      transition: none !important;
    }

    .hero-safe-query-check-box,
    .hero-safe-query-result {
      transition: none;
    }

    .hero-safe-query-check-box :global(.t-success-check) {
      animation: none !important;
      opacity: 1;
    }

    .hero-safe-query-check-box :global(.t-success-check svg path) {
      animation: none !important;
      stroke-dashoffset: 0 !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const successIcon = `<span class="hero-safe-query-status-check t-success-check" data-state="in" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M3.5 8.5L6.5 11.5L12.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>`;
    const scenarios = [
      { result: "pass" },
      { result: "blocked", failingStepId: "budgetLimit" },
    ];

    function swapText(element, nextText) {
      if (!element || element.textContent === nextText) {
        return;
      }

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        element.textContent = nextText;
        return;
      }

      element.classList.add("is-exit");
      window.setTimeout(() => {
        element.textContent = nextText;
        element.classList.remove("is-exit");
        element.classList.add("is-enter-start");

        window.requestAnimationFrame(() => {
          element.classList.remove("is-enter-start");
        });
      }, 120);
    }

    for (const surface of document.querySelectorAll(
      "[data-hero-product-surface]"
    )) {
      const tabOrder = (
        surface.getAttribute("data-hero-tab-order") || "integrations,query,audit"
      ).split(",");
      const dwell = {
        audit: Number(surface.getAttribute("data-hero-dwell-audit")) || 5000,
        integrations:
          Number(surface.getAttribute("data-hero-dwell-integrations")) || 5000,
        query: Number(surface.getAttribute("data-hero-dwell-query")) || 6500,
      };
      const delays = {
        initial:
          Number(surface.getAttribute("data-hero-safe-initial-delay")) || 360,
        resultHold:
          Number(surface.getAttribute("data-hero-safe-result-hold")) || 900,
        step: Number(surface.getAttribute("data-hero-safe-step-delay")) || 520,
      };
      const buttons = Array.from(
        surface.querySelectorAll("[data-hero-product-tab]")
      );
      const templates = new Map(
        Array.from(
          surface.querySelectorAll("[data-hero-product-panel-template]")
        ).map((template) => [
          template.getAttribute("data-hero-product-panel-template"),
          template,
        ])
      );
      const panelBody = surface.querySelector("[data-hero-product-panel-body]");
      const title = surface.querySelector("[data-hero-product-title]");
      const tag = surface.querySelector("[data-hero-product-tag]");
      let activeTab =
        surface.getAttribute("data-hero-initial-tab") || tabOrder[0];
      let safeQueryCycleIndex = 0;
      let safeQueryTimer;
      let tabTimer;

      const clearSafeQueryTimer = () => {
        if (safeQueryTimer !== undefined) {
          window.clearTimeout(safeQueryTimer);
          safeQueryTimer = undefined;
        }
      };

      const clearTabTimer = () => {
        if (tabTimer !== undefined) {
          window.clearTimeout(tabTimer);
          tabTimer = undefined;
        }
      };

      const scheduleTabAdvance = () => {
        clearTabTimer();
        tabTimer = window.setTimeout(() => {
          const tabIndex = tabOrder.indexOf(activeTab);
          const nextTab = tabOrder[(tabIndex + 1) % tabOrder.length];
          setActiveTab(nextTab || tabOrder[0]);
        }, dwell[activeTab] || 5000);
      };

      const setPanelOpen = () => {
        const panel = panelBody?.querySelector(".hero-product-panel");

        if (!panel) {
          return;
        }

        window.requestAnimationFrame(() => {
          panel.setAttribute("data-open", "true");
        });
      };

      const updateSafeQueryResult = (result) => {
        const query = panelBody?.querySelector(".hero-safe-query");
        const resultElement = panelBody?.querySelector(
          "[data-hero-safe-query-result]"
        );
        const text = panelBody?.querySelector(
          "[data-hero-safe-query-result-text]"
        );
        const label =
          result === "blocked"
            ? "BLOCKED"
            : result === "pass"
              ? "PASS"
              : "CHECKING";

        query?.setAttribute("data-result", result);
        resultElement?.setAttribute("data-result", result);
        swapText(text, label);
      };

      const updateSafeQueryCheck = (checkId, status) => {
        const check = panelBody?.querySelector(
          `[data-hero-safe-query-check="${checkId}"]`
        );
        const box = check?.querySelector("[data-hero-safe-query-check-box]");

        check?.setAttribute("data-status", status);

        if (!box) {
          return;
        }

        if (status === "success") {
          box.innerHTML = successIcon;
          return;
        }

        if (status === "failure") {
          box.innerHTML = `<span aria-hidden="true">x</span>`;
          return;
        }

        box.textContent = "";
      };

      const runSafeQueryCycle = () => {
        clearSafeQueryTimer();

        if (activeTab !== "query") {
          return;
        }

        const checkIds = Array.from(
          panelBody?.querySelectorAll("[data-hero-safe-query-check]") || []
        ).map((check) => check.getAttribute("data-hero-safe-query-check"));
        const scenario = scenarios[safeQueryCycleIndex % scenarios.length];
        let checkIndex = 0;

        safeQueryCycleIndex += 1;
        updateSafeQueryResult("pending");

        for (const checkId of checkIds) {
          updateSafeQueryCheck(checkId, "pending");
        }

        function step() {
          if (activeTab !== "query") {
            return;
          }

          const checkId = checkIds[checkIndex];

          if (!checkId) {
            updateSafeQueryResult("pass");
            safeQueryTimer = window.setTimeout(
              runSafeQueryCycle,
              delays.resultHold
            );
            return;
          }

          const status =
            scenario.result === "blocked" &&
            scenario.failingStepId === checkId
              ? "failure"
              : "success";

          updateSafeQueryCheck(checkId, status);
          checkIndex += 1;

          if (status === "failure") {
            updateSafeQueryResult("blocked");
            safeQueryTimer = window.setTimeout(
              runSafeQueryCycle,
              delays.resultHold
            );
            return;
          }

          if (checkIndex >= checkIds.length) {
            updateSafeQueryResult("pass");
            safeQueryTimer = window.setTimeout(
              runSafeQueryCycle,
              delays.resultHold
            );
            return;
          }

          safeQueryTimer = window.setTimeout(step, delays.step);
        }

        safeQueryTimer = window.setTimeout(step, delays.initial);
      };

      const renderTab = (tab) => {
        const template = templates.get(tab);

        if (!template || !panelBody) {
          return;
        }

        activeTab = tab;
        panelBody.innerHTML = template.innerHTML;
        title.textContent =
          template.getAttribute("data-hero-product-title") || "";
        tag.textContent = template.getAttribute("data-hero-product-tag") || "";

        for (const button of buttons) {
          const isActive =
            button.getAttribute("data-hero-product-tab") === activeTab;
          button.classList.toggle("hero-product-nav-active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        }

        setPanelOpen();
      };

      const setActiveTab = (tab) => {
        clearSafeQueryTimer();
        renderTab(tab);

        if (activeTab === "query") {
          runSafeQueryCycle();
        }

        scheduleTabAdvance();
      };

      for (const button of buttons) {
        button.addEventListener("click", () => {
          const tab = button.getAttribute("data-hero-product-tab");

          if (tab) {
            setActiveTab(tab);
          }
        });
      }

      scheduleTabAdvance();
    }
  })();
</script>
