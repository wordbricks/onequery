<section class="section marketing-updates">
  <div class="marketing-updates-copy">
    <p class="eyebrow">Stay in the loop</p>
    <h2>Get OneQuery updates.</h2>
  </div>

  <form
    class="marketing-updates-form"
    method="POST"
    action="/api/product-updates/"
    data-product-updates-form
  >
    <div class="marketing-inline-form">
      <input
        type="email"
        name="email"
        placeholder="you@company.com"
        class="marketing-input"
        aria-label="Email address"
        required
      />
      <button type="submit" class="button button-primary marketing-submit-button">
        Notify me
      </button>
    </div>

    <p
      class="marketing-form-feedback"
      role="status"
      aria-live="polite"
      data-product-updates-feedback
    >
      We only use this to send product updates.
    </p>
  </form>
</section>

<style>
  .marketing-updates {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 460px);
    gap: 28px;
    align-items: end;
    padding: 28px 32px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.015), rgba(0, 0, 0, 0.04)),
      var(--surface);
    box-shadow: var(--shadow-ring);
  }

  .marketing-updates-copy {
    max-width: 720px;
  }

  .marketing-updates-copy p:last-child {
    margin-top: 18px;
  }

  .marketing-updates-form {
    display: grid;
    gap: 12px;
  }

  .marketing-inline-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
  }

  .marketing-input {
    width: 100%;
    min-height: 46px;
    padding: 0 14px;
    border: 1px solid rgba(15, 23, 42, 0.18);
    border-radius: 10px;
    background: #ffffff;
    color: var(--ink);
    outline: none;
    font-size: 15px;
    line-height: 22px;
  }

  .marketing-input:focus {
    border-color: rgba(37, 99, 235, 0.45);
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
  }

  .marketing-submit-button {
    min-width: 132px;
  }

  @media (max-width: 1100px) {
    .marketing-updates {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .marketing-updates {
      padding-left: 20px;
      padding-right: 20px;
    }

    .marketing-inline-form {
      grid-template-columns: 1fr;
    }

    .marketing-submit-button {
      width: 100%;
    }
  }
</style>

<script>
  const PRODUCT_UPDATES_DEFAULT_MESSAGE =
    "Failed to subscribe for product updates";

  const readProductUpdatesErrorMessage = (payload) => {
    if (
      payload &&
      typeof payload === "object" &&
      "message" in payload &&
      typeof payload.message === "string" &&
      payload.message.length > 0
    ) {
      return payload.message;
    }

    return PRODUCT_UPDATES_DEFAULT_MESSAGE;
  };

  const setProductUpdatesFeedback = (feedback, message, state) => {
    feedback.textContent = message;
    feedback.classList.toggle(
      "marketing-form-feedback-success",
      state === "success"
    );
    feedback.classList.toggle(
      "marketing-form-feedback-error",
      state === "error"
    );
    feedback.setAttribute("role", state === "error" ? "alert" : "status");
  };

  for (const form of document.querySelectorAll(
    "[data-product-updates-form]"
  )) {
    if (!(form instanceof HTMLFormElement)) {
      continue;
    }

    const feedback = form.querySelector("[data-product-updates-feedback]");
    const submitButton = form.querySelector('button[type="submit"]');

    if (!(feedback instanceof HTMLElement)) {
      continue;
    }

    form.addEventListener("submit", async (event) => {
      if (!form.reportValidity()) {
        return;
      }

      event.preventDefault();
      const formData = new FormData(form);
      const email = String(formData.get("email") ?? "").trim();

      form.setAttribute("aria-busy", "true");
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      setProductUpdatesFeedback(feedback, "Sending...", "neutral");

      try {
        const response = await fetch(form.action, {
          body: JSON.stringify({ email }),
          headers: {
            accept: "application/json",
            "content-type": "application/json",
          },
          method: "POST",
        });
        const payload = await response.json().catch(() => null);

        if (!response.ok) {
          throw new Error(readProductUpdatesErrorMessage(payload));
        }

        const subscribedEmail =
          payload &&
          typeof payload === "object" &&
          "email" in payload &&
          typeof payload.email === "string"
            ? payload.email
            : email;

        form.reset();
        setProductUpdatesFeedback(
          feedback,
          `We'll send product updates to ${subscribedEmail}.`,
          "success"
        );

        if (typeof window.gtag === "function") {
          window.gtag("event", "sign_up", {
            method: "product_updates",
          });
        }
      } catch (error) {
        const message =
          error instanceof Error
            ? error.message
            : PRODUCT_UPDATES_DEFAULT_MESSAGE;
        setProductUpdatesFeedback(feedback, message, "error");
      } finally {
        form.removeAttribute("aria-busy");
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    });
  }
</script>
