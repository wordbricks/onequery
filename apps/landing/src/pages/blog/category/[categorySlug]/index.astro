---
import BlogIndex from "@/features/blog/components/Index.astro";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getBlogPostSummaries } from "@/features/blog/collection";
import { getBlogIndexPage } from "@/features/blog/index-page";
import {
  getBlogCategorySlug,
  getPopulatedBlogPostCategories,
} from "@/features/blog/taxonomy";
import type { BlogPostCategory } from "@/features/blog/taxonomy";

interface Props {
  category: BlogPostCategory;
}

export async function getStaticPaths() {
  const posts = await getBlogPostSummaries();

  return getPopulatedBlogPostCategories(posts).map((category) => ({
    params: { categorySlug: getBlogCategorySlug(category) },
    props: { category },
  }));
}

const { category } = Astro.props;
const page = await getBlogIndexPage({
  category,
  site: Astro.site,
});
---

<BlogLayout
  canonicalUrl={page.canonicalUrl}
  description={page.description}
  keywords={page.keywords}
  structuredData={page.structuredData}
  title={page.title}
>
  <BlogIndex
    activeCategory={page.activeCategory}
    categories={page.categories}
    posts={page.posts}
  />
</BlogLayout>
