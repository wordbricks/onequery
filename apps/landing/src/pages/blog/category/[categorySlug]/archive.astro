---
import BlogIndex from "../../../../components/blog/BlogIndex.astro";
import BlogLayout from "../../../../layouts/BlogLayout.astro";
import { getBlogIndexPage } from "../../../../landing/blog/blog-index-page";
import {
  BLOG_POST_CATEGORIES,
  getBlogCategorySlug,
} from "../../../../landing/blog/blog-taxonomy";
import type { BlogPostCategory } from "../../../../landing/blog/blog-taxonomy";

interface Props {
  category: BlogPostCategory;
}

export function getStaticPaths() {
  return BLOG_POST_CATEGORIES.map((category) => ({
    params: { categorySlug: getBlogCategorySlug(category) },
    props: { category },
  }));
}

const { category } = Astro.props;
const page = await getBlogIndexPage({
  category,
  site: Astro.site,
  sortDirection: "Oldest",
});
---

<BlogLayout
  canonicalUrl={page.canonicalUrl}
  description={page.description}
  keywords={page.keywords}
  robots={page.robots}
  structuredData={page.structuredData}
  title={page.title}
>
  <BlogIndex
    activeCategory={page.activeCategory}
    posts={page.posts}
    sortDirection={page.sortDirection}
  />
</BlogLayout>
