---
import BlogPostView from "../../components/blog/BlogPost.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import {
  getBlogPosts,
  getBlogPostSummaries,
} from "../../landing/blog/blog-collection";
import type { BlogPost as BlogPostData } from "../../landing/blog/blog-types";
import { getBlogPostShareImageMetadata } from "../../landing/blog/blog-images";
import { getBlogPostShareMetadata } from "../../landing/blog/blog-share-metadata";
import {
  createBlogPostStructuredData,
  getBlogPostKeywords,
} from "../../landing/seo/structured-data";

interface Props {
  post: BlogPostData;
}

export async function getStaticPaths() {
  return (await getBlogPosts()).map((post) => ({
    params: { postSlug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const postSummaries = await getBlogPostSummaries();
const imageMetadata = await getBlogPostShareImageMetadata(post, Astro.site);
const metadata = getBlogPostShareMetadata(post, Astro.site, imageMetadata);
const structuredData = createBlogPostStructuredData(
  post,
  Astro.site,
  imageMetadata
);
const articleMetaTags = [
  ...(metadata.publishedTime
    ? [
        {
          content: metadata.publishedTime,
          property: "article:published_time",
        },
      ]
    : []),
  {
    content: post.category,
    property: "article:section",
  },
  {
    content: "OneQuery Maintainers",
    name: "author",
  },
];
---

<BlogLayout
  canonicalUrl={metadata.canonicalUrl}
  description={metadata.description}
  imageAlt={metadata.imageAlt}
  imageHeight={metadata.imageHeight}
  imageUrl={metadata.imageUrl}
  imageWidth={metadata.imageWidth}
  keywords={getBlogPostKeywords(post)}
  metaTags={articleMetaTags}
  ogType="article"
  structuredData={structuredData}
  title={metadata.title}
  twitterTitle={metadata.twitterTitle}
>
  <BlogPostView post={post} postSummaries={postSummaries} />
</BlogLayout>
