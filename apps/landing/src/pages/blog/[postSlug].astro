---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BlogPostView from "@/features/blog/components/Post.astro";
import BlogLayout from "@/layouts/BlogLayout.astro";
import {
  getBlogPostEntries,
  getBlogPostSummaries,
  toBlogPost,
} from "@/features/blog/collection";
import { getBlogPostShareImageMetadata } from "@/features/blog/images";
import { getBlogPostShareMetadata } from "@/features/blog/share";
import {
  createBlogPostStructuredData,
  getBlogPostKeywords,
} from "@/shared/seo/schema";

interface Props {
  entry: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  return (await getBlogPostEntries()).map((entry) => ({
    params: { postSlug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const post = toBlogPost(entry, headings);
const postSummaries = await getBlogPostSummaries();
const imageMetadata = await getBlogPostShareImageMetadata(post, Astro.site);
const metadata = getBlogPostShareMetadata(post, Astro.site, imageMetadata);
const structuredData = createBlogPostStructuredData(
  post,
  Astro.site,
  imageMetadata
);
const articleMetaTags = [
  ...(metadata.publishedTime
    ? [
        {
          content: metadata.publishedTime,
          property: "article:published_time",
        },
      ]
    : []),
  {
    content: post.category,
    property: "article:section",
  },
  {
    content: "OneQuery Maintainers",
    name: "author",
  },
];
---

<BlogLayout
  canonicalUrl={metadata.canonicalUrl}
  description={metadata.description}
  imageAlt={metadata.imageAlt}
  imageHeight={metadata.imageHeight}
  imageUrl={metadata.imageUrl}
  imageWidth={metadata.imageWidth}
  keywords={getBlogPostKeywords(post)}
  metaTags={articleMetaTags}
  ogType="article"
  structuredData={structuredData}
  title={metadata.title}
  twitterTitle={metadata.twitterTitle}
>
  <BlogPostView
    Content={Content}
    headings={headings}
    post={post}
    postSummaries={postSummaries}
  />
</BlogLayout>
