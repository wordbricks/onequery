---
import BlogPostView from "../../components/blog/BlogPost.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/blog.css";
import {
  blogPostSummaries,
  loadBlogPostBySlug,
} from "../../landing/blog/blog-posts";
import { getBlogPostShareMetadata } from "../../landing/blog/blog-share-metadata";
import {
  createBlogPostStructuredData,
  getBlogPostKeywords,
} from "../../landing/seo/structured-data";
import type { BlogPost as BlogPostData } from "../../landing/blog/blog-posts";

export async function getStaticPaths() {
  const paths = await Promise.all(
    blogPostSummaries.map(async (summary) => {
      const post = await loadBlogPostBySlug(summary.slug);

      return {
        params: { postSlug: summary.slug },
        props: { post },
      };
    })
  );

  return paths.filter(
    (
      path
    ): path is {
      params: { postSlug: string };
      props: { post: BlogPostData };
    } => path.props.post !== undefined
  );
}

const { post } = Astro.props;
const metadata = getBlogPostShareMetadata(post, Astro.site);
const structuredData = createBlogPostStructuredData(post, Astro.site);
const articleMetaTags = [
  ...(metadata.publishedTime
    ? [
        {
          content: metadata.publishedTime,
          property: "article:published_time",
        },
      ]
    : []),
  {
    content: post.category,
    property: "article:section",
  },
  {
    content: "OneQuery Maintainers",
    name: "author",
  },
];
---

<BaseLayout
  canonicalUrl={metadata.canonicalUrl}
  description={metadata.description}
  imageAlt={metadata.imageAlt}
  imageHeight={metadata.imageHeight}
  imageUrl={metadata.imageUrl}
  imageWidth={metadata.imageWidth}
  keywords={getBlogPostKeywords(post)}
  metaTags={articleMetaTags}
  ogType="article"
  structuredData={structuredData}
  title={metadata.title}
  twitterTitle={metadata.twitterTitle}
>
  <BlogPostView post={post} />
</BaseLayout>
