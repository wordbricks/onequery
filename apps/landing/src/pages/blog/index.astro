---
import BlogIndex from "../../components/blog/BlogIndex.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getBlogShareImageMetadataBySlug } from "../../landing/blog/blog-image-assets";
import { getBlogPostSummaries } from "../../landing/blog/blog-collection";
import {
  createBlogIndexStructuredData,
  createCanonicalUrl,
} from "../../landing/seo/structured-data";

const title = "OneQuery Blog | Governed Data Access for AI Agents";
const description =
  "Notes from the OneQuery team on production data access, AI agent safety, telemetry, and operational workflows.";
const canonicalUrl = createCanonicalUrl("/blog", Astro.site);
const posts = await getBlogPostSummaries();
const postImages = await getBlogShareImageMetadataBySlug(
  posts,
  Astro.site
);
const structuredData = createBlogIndexStructuredData({
  description,
  postImages,
  posts,
  site: Astro.site,
  title,
});
---

<BlogLayout
  canonicalUrl={canonicalUrl}
  description={description}
  keywords="OneQuery blog, AI agent safety, governed data access, production data access, LLM telemetry, data agent workflows"
  structuredData={structuredData}
  title={title}
>
  <BlogIndex posts={posts} />
</BlogLayout>
