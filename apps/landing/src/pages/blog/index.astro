---
import BlogIndex from "@/features/blog/components/Index.astro";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getBlogIndexPage } from "@/features/blog/index-page";

const page = await getBlogIndexPage({
  category: "All",
  site: Astro.site,
});
---

<BlogLayout
  canonicalUrl={page.canonicalUrl}
  description={page.description}
  keywords={page.keywords}
  structuredData={page.structuredData}
  title={page.title}
>
  <BlogIndex
    activeCategory={page.activeCategory}
    categories={page.categories}
    posts={page.posts}
  />
</BlogLayout>
