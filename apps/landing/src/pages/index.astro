---
import ControlPlaneDiagram from "@/features/home/components/ControlPlaneDiagram.astro";
import DownloadCommand from "@/features/home/components/DownloadCommand.astro";
import HeroProductSurface from "@/features/home/components/HeroProductSurface.astro";
import OpenClawSection from "@/features/home/components/OpenClawSection.astro";
import ProductUpdatesSection from "@/features/home/components/ProductUpdatesSection.astro";
import RoadmapSection from "@/features/home/components/RoadmapSection.astro";
import TerminalSurface from "@/features/home/components/TerminalSurface.astro";
import TrackedLink from "@/shared/components/TrackedLink.astro";
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import {
  getOpenClawDemoPosterImage,
  OPEN_CLAW_DEMO_VIDEO,
} from "@/features/home/demo-video";
import {
  NPM_PACKAGE_URL,
  SECTION_IDS,
  SELF_HOST_DOCS_URL,
} from "@/shared/config/site";
import {
  createCanonicalUrl,
  createHomePageStructuredData,
  normalizeSiteUrl,
  toAbsoluteSiteUrl,
} from "@/shared/seo/schema";
import { ONEQUERY } from "@/shared/seo/constants";
import { getOneQueryShareImage } from "@/shared/seo/images";
import {
  HERO_SIGNALS,
  INSTALL_STEPS,
  QUERY_DETAILS_SNIPPET,
  QUERY_TERMINAL_LINES,
  QUICKSTART_TERMINAL_LINES,
} from "@/features/home/content";

// Keep the home page prerendered; dynamic signup posts to the API route.
export const prerender = true;

const title = ONEQUERY.DEFAULT_PAGE_TITLE;
const imageAlt = ONEQUERY.SHARE_IMAGE_ALT;
const siteUrl = normalizeSiteUrl(Astro.site);
const canonicalUrl = createCanonicalUrl("/", siteUrl);
const shareImage = getOneQueryShareImage(siteUrl);
const imageUrl = shareImage.url;
const openClawDemoPosterImage = await getOpenClawDemoPosterImage();
const structuredData = createHomePageStructuredData({
  description: ONEQUERY.SITE_DESCRIPTION,
  image: {
    alt: imageAlt,
    height: shareImage.height,
    url: shareImage.url,
    width: shareImage.width,
  },
  site: siteUrl,
  title,
  video: {
    contentUrl: OPEN_CLAW_DEMO_VIDEO.mp4Src,
    description: OPEN_CLAW_DEMO_VIDEO.description,
    duration: OPEN_CLAW_DEMO_VIDEO.duration,
    name: OPEN_CLAW_DEMO_VIDEO.name,
    pageUrl: `${canonicalUrl}#demo`,
    thumbnail: {
      height: OPEN_CLAW_DEMO_VIDEO.posterHeight,
      url: openClawDemoPosterImage.src,
      width: OPEN_CLAW_DEMO_VIDEO.posterWidth,
    },
    uploadDate: OPEN_CLAW_DEMO_VIDEO.uploadDate,
  },
});
const metaTags = [
  {
    content: toAbsoluteSiteUrl(OPEN_CLAW_DEMO_VIDEO.mp4Src, siteUrl),
    property: "og:video",
  },
  {
    content: toAbsoluteSiteUrl(OPEN_CLAW_DEMO_VIDEO.mp4Src, siteUrl),
    property: "og:video:secure_url",
  },
  {
    content: "video/mp4",
    property: "og:video:type",
  },
  {
    content: String(OPEN_CLAW_DEMO_VIDEO.width),
    property: "og:video:width",
  },
  {
    content: String(OPEN_CLAW_DEMO_VIDEO.height),
    property: "og:video:height",
  },
];

type CtaAction = {
  className: string;
  href: string;
  label: string;
  rel?: "noreferrer";
  target?: "_blank";
  trackingName: string;
  trackingSection: string;
};

const heroActions: ReadonlyArray<CtaAction> = [
  {
    className: "button button-primary",
    href: `#${SECTION_IDS.install}`,
    label: "Install CLI",
    trackingName: "hero_get_started",
    trackingSection: "hero",
  },
  {
    className: "button button-secondary",
    href: "#demo",
    label: "Watch demo",
    trackingName: "hero_watch_demo",
    trackingSection: "hero",
  },
] as const;

const finalCtaActions: ReadonlyArray<CtaAction> = [
  {
    className: "button button-primary",
    href: NPM_PACKAGE_URL,
    label: "Install from npm",
    rel: "noreferrer",
    target: "_blank",
    trackingName: "final_install_now",
    trackingSection: "final_cta",
  },
  {
    className: "button button-secondary",
    href: SELF_HOST_DOCS_URL,
    label: "Read self-host docs",
    rel: "noreferrer",
    target: "_blank",
    trackingName: "final_read_self_host_docs",
    trackingSection: "final_cta",
  },
] as const;
---

<MarketingLayout
  canonicalUrl={canonicalUrl}
  description={ONEQUERY.SITE_DESCRIPTION}
  imageAlt={imageAlt}
  imageHeight={shareImage.height}
  imageType={shareImage.type}
  imageUrl={imageUrl}
  imageWidth={shareImage.width}
  metaTags={metaTags}
  structuredData={structuredData}
  title={title}
>
  <main class="page-main">
      <section class="hero-section">
        <div class="hero-copy">
          <p class="eyebrow">Agent access control plane</p>
          <h1>Give AI agents production context, not production keys.</h1>
          <p class="hero-body">
            OneQuery gives agents a governed path to approved sources while
            credentials stay centralized and every query leaves an audit trail.
          </p>

          <div class="hero-install-command">
            <DownloadCommand />
          </div>

          <div class="hero-actions">
            {
              heroActions.map((action) => (
                <TrackedLink
                  class={action.className}
                  href={action.href}
                  target={action.target}
                  rel={action.rel}
                  trackingName={action.trackingName}
                  trackingSection={action.trackingSection}
                >
                  {action.label}
                </TrackedLink>
              ))
            }
          </div>
        </div>

        <div class="hero-visual">
          <HeroProductSurface />
        </div>

        <ul class="hero-signals">
          {HERO_SIGNALS.map((signal) => <li>{signal}</li>)}
        </ul>
      </section>

      <section class="section section-summary" id={SECTION_IDS.surface}>
        <div class="section-intro">
          <p class="eyebrow">What OneQuery does</p>
          <h2>Policy between agents and prod.</h2>
        </div>

        <ControlPlaneDiagram />
      </section>

      <section class="section utility-grid" id={SECTION_IDS.install}>
        <article class="utility-panel">
          <p class="eyebrow">First workflow</p>
          <h2>Debug production without sharing credentials.</h2>
          <ol class="step-list">
            {INSTALL_STEPS.map((step) => <li>{step}</li>)}
          </ol>
        </article>

        <article class="utility-panel utility-panel-code">
          <p class="eyebrow">Grant setup</p>
          <TerminalSurface
            title="Terminal session"
            lines={QUICKSTART_TERMINAL_LINES}
            footer="ready to debug production without sharing credentials"
          />
        </article>
      </section>

      <section
        class="section utility-grid utility-grid-offset"
        id={SECTION_IDS.workflow}
      >
        <article class="utility-panel utility-panel-code workflow-panel-example">
          <p class="eyebrow">Agent access</p>
          <TerminalSurface
            title="Agent terminal"
            lines={QUERY_TERMINAL_LINES}
            footer="GitHub, Sentry, and Slack through one audited access path"
          />
        </article>

        <article class="utility-panel workflow-panel-details">
          <p class="eyebrow">Access record</p>
          <h2>Real APIs, no exposed tokens.</h2>
          <p>
            Each call names an approved source and endpoint. OneQuery sends the
            request with server-side credentials and records what happened.
          </p>
          <pre class="workflow-block">{QUERY_DETAILS_SNIPPET}</pre>
        </article>
      </section>

      <RoadmapSection />
      <OpenClawSection />

      <section class="section final-cta">
        <div class="final-cta-copy">
          <p class="eyebrow">Built for real incidents</p>
          <h2>Give agents the clues, not the keys.</h2>
          <p>
            Agents can inspect errors, logs, and database state without raw
            credentials or permission to change production.
          </p>
        </div>

        <div class="final-cta-actions">
          {
            finalCtaActions.map((action) => (
              <TrackedLink
                class={action.className}
                href={action.href}
                target={action.target}
                rel={action.rel}
                trackingName={action.trackingName}
                trackingSection={action.trackingSection}
              >
                {action.label}
              </TrackedLink>
            ))
          }
        </div>
      </section>

      <ProductUpdatesSection />
  </main>
</MarketingLayout>

<style>
  .page-main {
    display: flex;
    flex-direction: column;
    gap: 88px;
    width: min(100%, var(--container));
    margin: 0 auto;
  }

  .hero-actions,
  .final-cta-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hero-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(28px, 4vw, 44px);
    padding: clamp(56px, 8vh, 84px) 0 0;
  }

  .hero-copy {
    max-width: min(100%, 980px);
  }

  .hero-copy h1,
  .section-intro h2,
  .utility-panel h2,
  .final-cta-copy h2 {
    margin: 18px 0 0;
    font-size: 4.05rem;
    font-weight: 600;
    line-height: 0.99;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .section-intro h2,
  .utility-panel h2,
  .final-cta-copy h2 {
    font-size: 3.25rem;
    line-height: 1.05;
  }

  .hero-body,
  .section-intro p,
  .utility-panel p,
  .final-cta-copy p,
  .hero-signals,
  .step-list {
    margin: 0;
    color: var(--text-muted);
    font-size: 18px;
    line-height: 1.65;
  }

  .hero-body {
    max-width: 760px;
    margin-top: 22px;
    text-wrap: pretty;
  }

  .hero-body code,
  .section-intro p code,
  .utility-panel p code,
  .final-cta-copy p code {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 9px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 9px;
    background: rgba(0, 0, 0, 0.09);
    color: var(--ink);
    font-size: 0.9em;
    font-weight: 600;
    line-height: 1;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.38);
  }

  .hero-actions {
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .hero-signals,
  .step-list {
    padding-left: 20px;
  }

  .hero-signals {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin-top: 0;
    max-width: 980px;
    padding-left: 0;
    font-size: 13px;
    line-height: 18px;
  }

  .hero-signals li {
    position: relative;
    min-height: 34px;
    padding: 8px 12px 8px 32px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: var(--shadow-ring);
  }

  .hero-signals li::before {
    content: "";
    position: absolute;
    top: 13px;
    left: 14px;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--success);
    box-shadow: 0 0 0 5px var(--success-soft);
  }

  .hero-signals li + li,
  .step-list li + li {
    margin-top: 0;
  }

  .step-list li + li {
    margin-top: 10px;
  }

  .hero-visual {
    display: flex;
    width: 100%;
  }

  .hero-copy > .eyebrow,
  .hero-copy h1,
  .hero-body,
  .hero-install-command,
  .hero-actions,
  .hero-signals {
    opacity: 0;
    transform: translateY(12px);
    animation: hero-copy-enter 680ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-copy h1 {
    animation-delay: 70ms;
  }

  .hero-body {
    animation-delay: 140ms;
  }

  .hero-install-command {
    animation-delay: 210ms;
  }

  .hero-actions {
    animation-delay: 280ms;
  }

  .hero-signals {
    animation-delay: 350ms;
  }

  @keyframes hero-copy-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .section-summary {
    gap: 28px;
  }

  .section-intro {
    max-width: 760px;
  }

  .section-intro p {
    margin-top: 20px;
  }

  .utility-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .utility-panel {
    min-height: 340px;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--shadow-ring);
  }

  .utility-panel p {
    margin-top: 18px;
  }

  .step-list {
    margin-top: 24px;
  }

  .utility-panel-code {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: #0d0d0d;
    border-color: rgba(0, 0, 0, 0.24);
    box-shadow: none;
  }

  .utility-panel-code p {
    margin-top: 0;
  }

  .utility-panel-code .eyebrow {
    color: rgba(255, 255, 255, 0.86);
  }

  .workflow-block {
    margin: 24px 0 0;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface-muted);
    color: var(--ink);
    white-space: pre-wrap;
    font-size: 15px;
    line-height: 1.7;
  }

  .utility-grid-offset {
    align-items: stretch;
  }

  .final-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: end;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--shadow-ring);
  }

  .final-cta-copy {
    max-width: 760px;
  }

  .final-cta-copy p {
    margin-top: 18px;
  }

  .final-cta-actions {
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 1100px) {
    .hero-section {
      grid-template-columns: 1fr;
    }

    .final-cta {
      grid-template-columns: 1fr;
    }

    .final-cta-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 860px) {
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-section {
      gap: 28px;
      padding-top: 40px;
    }

    .hero-copy h1,
    .section-intro h2,
    .utility-panel h2,
    .final-cta-copy h2 {
      font-size: 3.15rem;
    }

    .utility-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .page-main {
      gap: 64px;
    }

    .hero-section {
      gap: 24px;
      padding-top: 20px;
    }

    .workflow-panel-details {
      order: -1;
    }

    .hero-copy h1,
    .section-intro h2,
    .utility-panel h2,
    .final-cta-copy h2 {
      font-size: 2.6rem;
      letter-spacing: 0;
    }

    .hero-body,
    .section-intro p,
    .utility-panel p,
    .final-cta-copy p,
    .hero-signals,
    .step-list {
      font-size: 16px;
    }

    .hero-actions {
      width: 100%;
    }

    .hero-signals {
      grid-template-columns: 1fr;
    }

    .hero-actions :global(.button-primary) {
      width: 100%;
    }

    .utility-panel,
    .final-cta {
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy > .eyebrow,
    .hero-copy h1,
    .hero-body,
    .hero-install-command,
    .hero-actions,
    .hero-signals {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
