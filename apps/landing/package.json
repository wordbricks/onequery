{
  "name": "@onequery/landing",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "dev:worker": "bunx wrangler dev",
    "build": "bunx --bun vite build",
    "deploy": "bun run build && bunx wrangler deploy",
    "deploy:preview": "bun run build && bunx wrangler versions upload",
    "cf-typegen": "bunx wrangler types worker-configuration.d.ts --env-interface CloudflareEnv",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@bufbuild/protovalidate": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-query": "2.2.0",
    "@connectrpc/connect-web": "2.1.1",
    "@connectrpc/validate": "catalog:",
    "@onequery/landing-video": "workspace:*",
    "@onequery/ui": "workspace:*",
    "@remotion/player": "4.0.448",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@xstate/react": "catalog:",
    "better-result": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remotion": "catalog:",
    "xstate": "catalog:"
  },
  "devDependencies": {
    "@onequery/installer": "workspace:*",
    "@rolldown/plugin-babel": "catalog:tooling",
    "@tanstack/router-plugin": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:tooling",
    "babel-plugin-react-compiler": "catalog:tooling",
    "vite": "catalog:tooling",
    "vitest": "catalog:testing"
  }
}
