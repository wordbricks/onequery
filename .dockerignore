# Dependencies
**/node_modules/
**/.bun/

# Build outputs
**/dist/
**/.turbo/

# Development files
**/*.log
**/*.local
**/.env*

# IDE
.idea/
.vscode/
**/*.swp
**/*.swo

**/coverage/

# Git
.git/
.gitignore

# OS files
**/.DS_Store
**/Thumbs.db

# Large generated files
**/*.tsbuildinfo

# Exclude web app source (not needed for agent container)
# Keep package.json for bun.lock workspace resolution
apps/web/src/
apps/web/public/
apps/web/e2e/
apps/web/*.html
apps/web/*.config.*

# Exclude test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/vitest.config.ts
**/playwright.config.ts
**/playwright/
