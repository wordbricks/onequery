{
  "name": "@onequery/self-host-runtime",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./assets": "./src/assets.ts",
    "./client": "./src/client.ts",
    "./dev-runner": "./src/dev-runner.ts",
    "./packaged-entry": "./src/node-entry.ts"
  },
  "scripts": {
    "build:web": "bun run --cwd ../../apps/web build",
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ../../scripts/run-self-host-runtime.ts --dev",
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ../../scripts/run-self-host-smoke.ts serve",
    "serve": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ../../scripts/run-self-host-smoke.ts serve",
    "test": "vitest run --exclude 'src/**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@bufbuild/protovalidate": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-node": "catalog:",
    "@connectrpc/validate": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/structured-logger": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@onequery/base": "workspace:*",
    "@onequery/cli-server": "workspace:*",
    "@onequery/config": "workspace:*",
    "@onequery/db": "workspace:*",
    "@onequery/installer": "workspace:*",
    "@onequery/proto-runtime": "workspace:*",
    "@onequery/server": "workspace:*",
    "antiox": "catalog:",
    "better-result": "catalog:",
    "hono": "catalog:",
    "hono-problem-details": "catalog:",
    "pino": "catalog:",
    "unstorage": "catalog:",
    "zod": "catalog:"
  }
}
