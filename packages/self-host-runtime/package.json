{
  "name": "@onequery/self-host-runtime",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./assets": "./src/assets.ts",
    "./client": "./src/client.ts",
    "./install-script": {
      "types": "./src/install-script.ts",
      "bun": "./src/install-script.ts",
      "default": "./dist/install-script.js"
    },
    "./packaged-entry": "./src/node-entry.ts"
  },
  "scripts": {
    "build": "bun build ./src/install-script.ts --outfile ./dist/install-script.js --target node --format esm",
    "build:web": "bun run --cwd ../../apps/web build",
    "dev": "bun run ../../scripts/run-self-host-runtime.ts --dev",
    "start": "bun run ../../scripts/run-self-host-smoke.ts serve",
    "serve": "bun run ../../scripts/run-self-host-smoke.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@onequery/base": "workspace:*",
    "@onequery/cli-server": "workspace:*",
    "@onequery/config": "workspace:*",
    "@onequery/db": "workspace:*",
    "@onequery/server": "workspace:*",
    "hono": "catalog:",
    "hono-problem-details": "catalog:",
    "unstorage": "catalog:",
    "zod": "catalog:"
  }
}
