{
  "name": "@onequery/github-rulesets",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "rulesets:check": "bun run ./src/cli.ts --check",
    "rulesets:plan": "bun run ./src/cli.ts --plan",
    "rulesets:apply": "bun run ./src/cli.ts --apply",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "catalog:testing"
  }
}
