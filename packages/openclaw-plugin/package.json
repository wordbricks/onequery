{
  "name": "@onequery/openclaw-plugin",
  "version": "0.0.0",
  "private": false,
  "description": "OneQuery OpenClaw plugin",
  "keywords": [
    "onequery",
    "openclaw",
    "plugin"
  ],
  "homepage": "https://github.com/wordbricks/onequery/tree/main/packages/openclaw-plugin#readme",
  "bugs": {
    "url": "https://github.com/wordbricks/onequery/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wordbricks/onequery.git",
    "directory": "packages/openclaw-plugin"
  },
  "files": [
    "src/index.ts",
    "src/openclaw.d.ts",
    "README.md",
    "openclaw.plugin.json",
    "skills",
    "tsconfig.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "openclaw": "2026.4.10"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.4.10",
      "minGatewayVersion": "2026.4.10"
    },
    "build": {
      "openclawVersion": "2026.4.10",
      "pluginSdkVersion": "2026.4.10"
    }
  }
}
