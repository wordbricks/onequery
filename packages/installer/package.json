{
  "name": "@onequery/installer",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/install-script.ts",
      "bun": "./src/install-script.ts",
      "default": "./dist/install-script.js"
    }
  },
  "scripts": {
    "build": "bun build src/install-script.ts --outdir dist --target node --format esm",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@onequery/base": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:testing"
  }
}
