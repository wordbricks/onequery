{
  "name": "@onequery/db",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./constants": "./src/constants.ts",
    "./credentials": "./src/credentials.ts",
    "./pglite": "./src/pglite.ts",
    "./testing/setup": "./src/testing/setup.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --exclude 'src/**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "test:watch": "vitest",
    "db:generate": "bun run ../../scripts/run-local-env-command.ts -- drizzle-kit generate",
    "db:migrate": "bun run ../../scripts/run-local-env-command.ts -- drizzle-kit migrate",
    "db:migrate:ci": "drizzle-kit migrate",
    "db:push": "bun run ../../scripts/run-local-env-command.ts -- drizzle-kit push",
    "db:studio": "bun run ../../scripts/run-local-env-command.ts -- drizzle-kit studio",
    "db:seed:dev": "bun run ../../scripts/run-local-env-command.ts -- bun src/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.4.2",
    "@onequery/base": "workspace:*",
    "@onequery/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "catalog:",
    "postgres": "3.4.8",
    "ulid": "3.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "drizzle-kit": "0.31.10"
  }
}
