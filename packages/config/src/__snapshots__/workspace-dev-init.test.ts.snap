// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ensureWorkspaceDevSecretsFileSync > creates onequery.dev.secrets.toml when missing 1`] = `
{
  "contents": "# Generated by OneQuery local bootstrap.
# This file is local-only and intentionally gitignored.

[auth]
secret = "<generated-auth-secret>"

[crypto]
master_encryption_key = "<generated-master-encryption-key>"

[connectors]
enrollment_token = "<generated-enrollment-token>"
",
  "result": {
    "created": true,
    "path": "<rootDir>/onequery.dev.secrets.toml",
  },
}
`;
