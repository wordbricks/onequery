// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`@onequery/config workspace-dev > parses workspace-dev config and produces stable projections 1`] = `
{
  "dockerCompose": {
    "environment": {
      "POSTGRES_DB": "workspace",
      "POSTGRES_PASSWORD": "secret",
      "POSTGRES_USER": "workspace",
    },
    "postgres": {
      "containerPort": 5433,
      "hostPort": 6500,
      "portBinding": "6500:5433",
    },
  },
  "drizzle": {
    "databaseUrl": "postgres://workspace:secret@localhost:6500/workspace",
  },
  "serverLaunch": {
    "workspaceDev": {
      "common": {
        "assets": {
          "distDir": "/tmp/workspace-web",
        },
        "auth": {
          "secret": "workspace-auth-secret",
        },
        "connectors": {
          "enrollmentToken": "workspace-connector-token",
        },
        "crypto": {
          "masterEncryptionKey": "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=",
        },
        "listen": {
          "host": "127.0.0.1",
          "port": 4601,
        },
        "migrations": {
          "dir": "/tmp/workspace-migrations",
        },
        "publicOrigin": "http://127.0.0.1:4600",
        "rateLimit": {
          "api": {
            "storage": "SERVER_LAUNCH_API_RATE_LIMIT_STORAGE_MEMORY",
          },
          "enabled": true,
        },
        "storage": {
          "postgres": {
            "url": "postgres://workspace:secret@localhost:6500/workspace",
          },
        },
      },
    },
  },
  "testProfile": {
    "database": {
      "database": "test",
      "host": "localhost",
      "password": "test",
      "port": 6500,
      "url": "postgres://test:test@localhost:6500/test",
      "user": "test",
    },
    "profile": "test",
  },
  "vite": {
    "apiProxyTarget": "http://127.0.0.1:4601",
    "port": 4600,
  },
}
`;
