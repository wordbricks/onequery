      "default": "./src/projections/server-launch.ts"
    },
    "./projections/vite": {
      "types": "./src/projections/vite.ts",
      "bun": "./src/projections/vite.ts",
      "default": "./src/projections/vite.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@onequery/config-loader": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:"
