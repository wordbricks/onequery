{
  "name": "@onequery/config",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server-launch": {
      "types": "./src/server-launch.ts",
      "bun": "./src/server-launch.ts",
      "default": "./src/server-launch.ts"
    },
    "./workspace-dev": {
      "types": "./src/workspace-dev.ts",
      "bun": "./src/workspace-dev.ts",
      "default": "./src/workspace-dev.ts"
    },
    "./workspace-dev-init": {
      "types": "./src/workspace-dev-init.ts",
      "bun": "./src/workspace-dev-init.ts",
      "default": "./src/workspace-dev-init.ts"
    },
    "./test-profile": {
      "types": "./src/test-profile.ts",
      "bun": "./src/test-profile.ts",
      "default": "./src/test-profile.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "bun": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./projections/docker": {
      "types": "./src/projections/docker.ts",
