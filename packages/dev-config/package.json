{
  "name": "@onequery/dev-config",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    "./topology": {
      "types": "./src/topology.ts",
      "bun": "./src/topology.ts",
      "default": "./dist/topology.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/topology.ts --outdir ./dist --target node --format esm --packages external --root ./src --entry-naming '[name].js'",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@onequery/config-loader": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
