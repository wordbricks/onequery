{
  "name": "@onequery/dev-config",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "exports": {
    "./local-env": "./src/local-env.ts",
    "./runtime": "./src/runtime.ts",
    "./topology": "./src/topology.ts"
  },
  "scripts": {
    "build": "bun build ./src/local-env.ts ./src/runtime.ts ./src/topology.ts --outdir ./dist --target node --format esm --packages external --root ./src --entry-naming '[name].js'",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@onequery/config-loader": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
