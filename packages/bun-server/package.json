{
  "name": "@onequery/bun-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build:web": "bun run --cwd ../../apps/web build",
    "dev": "bun run ../../scripts/run-bun-server.ts --dev",
    "start": "bun src/index.ts",
    "start:local": "bun run ../../scripts/run-bun-server.ts --local",
    "serve": "bun run build:web && bun run start:local",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "catalog:",
    "@onequery/base": "workspace:*",
    "@onequery/cli-server": "workspace:*",
    "@onequery/config-loader": "workspace:*",
    "@onequery/db": "workspace:*",
    "@onequery/dev-config": "workspace:*",
    "@onequery/server": "workspace:*",
    "hono": "catalog:",
    "hono-problem-details": "catalog:",
    "unstorage": "catalog:",
    "zod": "catalog:"
  }
}
