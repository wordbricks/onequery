// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`cli query action trail > completes validate actions and persists failure hints 1`] = `
{
  "failedAction": {
    "errorDetail": "failed to decrypt credentials",
    "errorHint": "verify the source configuration and retry",
    "id": "<executeActionId>",
    "stage": "completed",
    "status": "query_preparation_failed",
  },
  "failedEvent": {
    "errorDetail": "failed to decrypt credentials",
    "errorHint": "verify the source configuration and retry",
    "id": "<failedEventId>",
  },
  "validateAction": {
    "id": "<validateActionId>",
    "lastEventId": "<validatedEventId>",
    "normalizedSql": "SELECT answer FROM stats LIMIT 1000",
    "normalizedSqlChanged": true,
    "stage": "completed",
    "status": "succeeded",
    "version": 3,
  },
}
`;

