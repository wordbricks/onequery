exports[`cli query action trail > treats duplicate workflow event delivery as idempotent 1`] = `
{
  "action": {
    "id": "<actionId>",
    "lastEventId": "<sourceLoadedEventId>",
    "stage": "validate_query",
    "status": "pending",
    "version": 2,
  },
  "first": {
    "eventId": "<sourceLoadedEventId>",
  },
  "second": {
    "eventId": "<sourceLoadedEventId>",
  },
}
`;
