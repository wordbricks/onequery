exports[`connect error helpers > serializes resource info as a standard Connect detail 1`] = `
{
  "badRequest": [],
  "code": "NotFound",
  "errorInfo": [
    {
      "domain": "onequery.cli.v1",
      "metadata": {
        "problemStage": "resolve_source",
        "retryable": "false",
      },
      "reason": "SOURCE_NOT_FOUND",
    },
  ],
  "metadata": {},
  "rawMessage": "no source named "warehouse" exists in org "acme"",
  "resourceInfo": [
    {
      "description": "source was not found",
      "owner": "acme",
      "resourceName": "warehouse",
      "resourceType": "onequery.cli.source",
    },
  ],
  "retryInfo": [],
}
`;

